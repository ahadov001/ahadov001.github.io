{"__q": {"t": "Словосочетание — Сборник 2", "q": [{"s": "Грамматическая основа предложения — это...", "o": ["подлежащее и сказуемое", "определение", "словосочетание", "дополнение"], "e": "Главные члены предложения."}, {"s": "Подлежащее отвечает на вопросы...", "o": ["кого? чего?", "как?", "какой?", "кто? что?"], "e": "Подлежащее."}, {"s": "Сказуемое обозначает...", "o": ["то, что говорится о подлежащем", "предмет", "признак", "количество"], "e": "Сказуемое."}, {"s": "Дополнение отвечает на вопросы...", "o": ["какой?", "где?", "кто? что?", "косвенных падежей"], "e": "Дополнение."}, {"s": "Определение отвечает на вопросы...", "o": ["кому?", "где?", "какой? чей?", "как?"], "e": "Определение."}, {"s": "Обстоятельство отвечает на вопросы...", "o": ["кто?", "кого?", "какой?", "где? когда? как? почему?"], "e": "Обстоятельство."}, {"s": "Главные члены предложения:", "o": ["обстоятельство", "все", "дополнение и определение", "подлежащее и сказуемое"], "e": "Остальные члены — второстепенные."}, {"s": "В предложении «Ученик читает интересную книгу» дополнение:", "o": ["ученик", "книгу", "интересную", "читает"], "e": "Что? — книгу."}, {"s": "В том же предложении определение:", "o": ["интересную", "ученик", "книгу", "читает"], "e": "Какую? — интересную."}, {"s": "Простое глагольное сказуемое выражается...", "o": ["наречием", "существительным", "двумя словами", "одним глаголом"], "e": "«Мальчик читает»."}]}, "Словосочетание — 2-ci toplu": "Словосочетание — Сборник 2"}