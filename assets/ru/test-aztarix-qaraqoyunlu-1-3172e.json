{"__q": {"t": "Гарагоюнлу и Аггоюнлу — Сборник 1", "q": [{"s": "Когда возникло государство Гарагоюнлу?", "o": ["XIII век", "XII век", "Конец XIV века", "XVI век"], "e": "В 1410 году укрепило свою независимость."}, {"s": "Кто самый сильный правитель государства Гарагоюнлу?", "o": ["Кара Юсиф", "Джаханшах", "Якуб", "Узун Гасан"], "e": "При нём государство имело наибольшую территорию."}, {"s": "Под каким псевдонимом писал стихи Джаханшах?", "o": ["Насими", "Физули", "Хатаи", "Хакики"], "e": "Был одновременно и правителем, и поэтом."}, {"s": "В каком городе находится Голубая мечеть?", "o": ["Баку", "Тебриз", "Гянджа", "Шамахы"], "e": "Построена при Джаханшахе."}, {"s": "Кто самый известный правитель государства Аггоюнлу?", "o": ["Джаханшах", "Шах Исмаил", "Узун Гасан", "Кара Юсиф"], "e": "Превратил государство в сильную империю."}, {"s": "С каким государством воевал Узун Гасан?", "o": ["Индия", "Россия", "Османская империя", "Египет"], "e": "Известна битва при Отлукбели."}, {"s": "Когда произошла битва при Отлукбели?", "o": ["1555", "1501", "1410", "1473"], "e": "Аггоюнлу потерпели поражение."}, {"s": "Какой город был столицей государства Аггоюнлу?", "o": ["Баку", "Шамахы", "Тебриз", "Гянджа"], "e": "Тебриз был политическим центром."}, {"s": "Что регулировал «Ганунаме» Узун Гасана?", "o": ["Военное дело", "Налоговые и земельные отношения", "Религию", "Торговлю"], "e": "Важный правовой документ."}, {"s": "Кто положил конец государству Гарагоюнлу?", "o": ["Шах Исмаил", "Узун Гасан", "Теймур", "Надир-шах"], "e": "В 1467 году разгромил Джаханшаха."}]}, "Qaraqoyunlu və Ağqoyunlu — 1-ci toplu": "Гарагоюнлу и Аггоюнлу — Сборник 1"}