{"__q": {"t": "Пассивный залог — Сборник 1", "q": [{"s": "Change to passive: «They build houses.»", "o": ["Houses are built.", "Houses were built.", "Houses are building.", "Houses build."], "e": "Present Simple Passive: am/is/are + III форма."}, {"s": "Complete: «The letter ___ yesterday.»", "o": ["was sent", "sent", "sends", "is sent"], "e": "Past Simple Passive."}, {"s": "Choose: «English ___ all over the world.»", "o": ["spoke", "is spoken", "speaks", "is speaking"], "e": "Present Simple Passive."}, {"s": "Complete: «The work ___ by tomorrow.»", "o": ["finishes", "will finish", "will be finished", "is finishing"], "e": "Future Simple Passive."}, {"s": "Choose: «The house ___ now.»", "o": ["painted", "paints", "is painting", "is being painted"], "e": "Present Continuous Passive."}, {"s": "Complete: «The book ___ already ___ .»", "o": ["has / published", "was / publishing", "is / published", "has / been published"], "e": "Present Perfect Passive."}, {"s": "Which sentence is passive?", "o": ["He wrote a letter.", "He writes letters.", "A letter was written by him.", "He is writing."], "e": "Подлежащее испытывает действие."}, {"s": "Complete: «This bridge ___ in 1990.»", "o": ["is built", "builds", "was built", "built"], "e": "Конкретный прошедший год → Past Simple Passive."}, {"s": "Choose: «The room ___ every day.»", "o": ["is cleaning", "cleans", "cleaned", "is cleaned"], "e": "Повторяющееся действие, пассивный залог."}, {"s": "Complete: «The car ___ when I arrived.»", "o": ["repaired", "was being repaired", "was repairing", "is repaired"], "e": "Past Continuous Passive."}]}, "Passive Voice — 1-ci toplu": "Пассивный залог — Сборник 1"}