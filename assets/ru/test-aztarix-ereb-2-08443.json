{"__q": {"t": "Период Арабского халифата — Сборник 2", "q": [{"s": "Какого цвета было знамя хуррамитов?", "o": ["Красное", "Зелёное", "Белое", "Чёрное"], "e": "«Сюрхелем» — их называли краснознамёнными."}, {"s": "Кто составлял социальную базу движения Бабека?", "o": ["Духовенство", "Крестьяне и ремесленники", "Купцы", "Знать"], "e": "Слои, страдавшие от гнёта."}, {"s": "Какой город был административным центром Арабского халифата в Азербайджане?", "o": ["Тебриз", "Барда", "Баку", "Шамахы"], "e": "Барда был центром области Арран."}, {"s": "К чему привело ослабление Халифата в IX веке?", "o": ["К новому завоеванию", "К объединению", "Изменений не было", "К образованию независимых феодальных государств"], "e": "Возникли Ширваншахи, Саджиды, Салариды."}, {"s": "Что символизирует образ Бабека в азербайджанской культуре?", "o": ["Религию", "Торговлю", "Борьбу за свободу", "Науку"], "e": "Символ национального героизма."}, {"s": "Какой культурный процесс происходил в период арабского завоевания?", "o": ["Изоляция", "Изменений не было", "Уничтожение культуры", "Взаимодействие и слияние с исламской культурой"], "e": "Развились наука, архитектура и литература."}, {"s": "На каком языке писали азербайджанские учёные в период Халифата?", "o": ["Только на тюркском", "На греческом", "В основном на арабском и персидском", "Только на албанском"], "e": "Языком науки был арабский."}, {"s": "В чём заключалось стратегическое значение крепости Баз?", "o": ["Торговый центр", "Горная, легко обороняемая местность", "Морской порт", "Религиозный центр"], "e": "Имелись естественные условия для обороны."}, {"s": "Каков был итог движения Бабека?", "o": ["Потерпело поражение, но ослабило Халифат", "Полная победа", "Изменений не было", "Создано новое государство"], "e": "Ускорило падение Халифата."}, {"s": "Что обусловило развитие городов Азербайджана в период Халифата?", "o": ["Климат", "Войны", "Торговые пути и ремесло", "Изоляция"], "e": "Международная торговля оживилась."}]}, "Ərəb xilafəti dövrü — 2-ci toplu": "Период Арабского халифата — Сборник 2"}