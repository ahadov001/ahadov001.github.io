{"__q": {"t": "Начало XX века — Сборник 1", "q": [{"s": "Когда начал выходить журнал «Молла Насреддин»?", "o": ["1906", "1912", "1900", "1918"], "e": "Начал выходить в 1906 году в Тифлисе."}, {"s": "Кто был редактором журнала «Молла Насреддин»?", "o": ["Г.Джавид", "Дж.Мамедкулизаде", "М.А.Сабир", "А.Гагвердиев"], "e": "Джалил Мамедкулизаде был издателем и редактором журнала."}, {"s": "Как называется сборник сатирических стихов М.А.Сабира?", "o": ["Гюлистан", "Диван", "Хохопнаме", "Хамса"], "e": "«Хохопнаме» — собрание стихотворений Сабира."}, {"s": "Что означает псевдоним Сабира «Хопхоп»?", "o": ["Название профессии", "Не прозвище", "Название птицы — вестника", "Название города"], "e": "Удод (хопхоп) в восточной литературе — птица-вестник."}, {"s": "Кто автор произведения «Мёртвые»?", "o": ["Н.Нариманов", "М.А.Сабир", "Г.Джавид", "Дж.Мамедкулизаде"], "e": "Известная сатирическая трагикомедия Мирзы Джалила."}, {"s": "Что подвергается критике в «Мёртвых»?", "o": ["Образование", "Наука", "Религиозные предрассудки и невежество", "Торговля"], "e": "Образом шейха Насруллаха разоблачается мошенничество."}, {"s": "Что является главной мишенью сатиры Сабира?", "o": ["Любовь", "Невежество, суеверия, социальная несправедливость", "История", "Природа"], "e": "Отсталость общества подвергается острой насмешке."}, {"s": "Какова тема рассказа Дж.Мамедкулизаде «Почтовый ящик»?", "o": ["Горькие последствия неграмотности", "Любовь", "Путешествие", "Война"], "e": "Новрузали наказан из-за своей неграмотности."}, {"s": "Каков был стиль журнала «Молла Насреддин»?", "o": ["Строго научный", "Официальный", "Лирический", "Сатирический, с карикатурами"], "e": "Острая сатира и карикатуры были главным оружием журнала."}, {"s": "Каким приёмом широко пользовался Сабир в своих стихах?", "o": ["Восхваление", "Ирония и насмешка", "Наставление", "Сухое описание"], "e": "Он говорит языком образа и тем самым его разоблачает."}]}, "XX əsrin əvvəli — 1-ci toplu": "Начало XX века — Сборник 1"}