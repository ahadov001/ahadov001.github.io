{"__q": {"t": "Климат и воды Азербайджана — Сборник 1", "q": [{"s": "Сколько из 11 существующих в мире типов климата имеется в Азербайджане?", "o": ["11", "3", "5", "9"], "e": "Из-за разнообразия рельефа."}, {"s": "Какой тип климата является основным в Азербайджане?", "o": ["Экваториальный", "Тропический", "Арктический", "Сухой и полусухой субтропический"], "e": "Преобладает на равнинах."}, {"s": "Какой климат в Ленкорань-Астаринской зоне?", "o": ["Пустынный", "Арктический", "Влажный субтропический", "Сухой"], "e": "Это территория с наибольшим количеством осадков."}, {"s": "В какой части Азербайджана выпадает больше всего осадков?", "o": ["Ленкоранская низменность", "Муган", "Нахчыван", "Апшерон"], "e": "1 200–1 700 мм."}, {"s": "В какой части Азербайджана выпадает меньше всего осадков?", "o": ["Ленкорань", "Апшерон и Нахчыван", "Загатала", "Гусар"], "e": "200–300 мм."}, {"s": "Как Каспийское море влияет на климат?", "o": ["Вызывает засуху", "Только охлаждает", "Смягчает температуру, повышает влажность", "Не влияет"], "e": "Смягчающее влияние."}, {"s": "С какой стороны дует ветер хазри?", "o": ["Восток", "Север", "Юг", "Запад"], "e": "Он прохладный и сильный."}, {"s": "Какой ветер гилавар?", "o": ["Тёплый южный ветер", "Холодный северный", "Западный", "Восточный"], "e": "Влажный и тёплый."}, {"s": "Какая река является самой большой в Азербайджане?", "o": ["Самур", "Аракс", "Ганых", "Кура"], "e": "Длина 1 515 км."}, {"s": "Притоком какой реки является Аракс?", "o": ["Самур", "Терек", "Кура", "Волга"], "e": "Является правым притоком."}]}, "Azərbaycanın iqlimi və suları — 1-ci toplu": "Климат и воды Азербайджана — Сборник 1"}