{"__q": {"t": "Период ханств — Сборник 2", "q": [{"s": "Какой памятник архитектуры является самым известным в Шекинском ханстве?", "o": ["Момине хатун", "Голубая мечеть", "Дворец шекинских ханов", "Девичья башня"], "e": "Шедевр искусства шебеке (витражей)."}, {"s": "Какова была основная форма управления в ханствах?", "o": ["Теократия", "Феодальная монархия во главе с ханом", "Демократия", "Республика"], "e": "Хан обладал абсолютной властью."}, {"s": "Что составляло основу экономики в период ханств?", "o": ["Банки", "Сельское хозяйство и ремёсла", "Промышленность", "Мореплавание"], "e": "Развивались шелководство и ковроткачество."}, {"s": "Какой город был столицей Карабахского ханства?", "o": ["Барда", "Гянджа", "Шуша", "Агдам"], "e": "После Баята и Шахбулага — Шуша."}, {"s": "Кто был последним ханом Бакинского ханства?", "o": ["Гусейнкулу хан", "Фатали хан", "Мустафа хан", "Джавад хан"], "e": "В 1806 году Баку был захвачен Россией."}, {"s": "Каковы были отношения между ханствами?", "o": ["Только вражда", "И союзы, и вражда", "Полное единство", "Изоляция"], "e": "Политическая обстановка была сложной."}, {"s": "Когда Иреванское ханство было захвачено Россией?", "o": ["1828", "1813", "1804", "1827"], "e": "До Туркменчайского договора."}, {"s": "Какова была судьба Нахчыванского ханства?", "o": ["Осталось независимым", "Распалось", "Перешло к России по Туркменчайскому договору", "Вошло в состав Османской империи"], "e": "В 1828 году."}, {"s": "Какие виды налогов существовали в ханствах?", "o": ["Налогов не было", "Только денежный налог", "Маляджахат, бахре, чобанбеги и др.", "Только таможенные пошлины"], "e": "Многочисленные натуральные и денежные налоги."}, {"s": "Каким был итог политической деятельности Вагифа?", "o": ["Эмиграция", "Долгая жизнь", "Ушёл на пенсию", "Казнён во время дворцового переворота"], "e": "Убит в 1797 году."}]}, "Xanlıqlar dövrü — 2-ci toplu": "Период ханств — Сборник 2"}