{"__q": {"t": "Поэзия Средних веков — Сборник 3", "q": [{"s": "Под каким эпитетом известен Низами?", "o": ["Хакан", "Хаким (мудрец)", "Султан", "Шейх"], "e": "«Хаким Низами» — в значении «мудрый поэт»."}, {"s": "Принцессой какой страны является Ширин в «Хосрове и Ширин»?", "o": ["Рум", "Индия", "Арминия (Барда)", "Иран"], "e": "Ширин — племянница правительницы Барды Мехин Бану."}, {"s": "Каковы язык и стиль поэм Низами?", "o": ["Простой, разговорный язык", "Богатый образами, философский", "Сухой, научный", "Сатирический"], "e": "Язык Низами полон богатых метафор и сравнений."}, {"s": "Где родился Хагани Ширвани?", "o": ["Баку", "Тебриз", "Гянджа", "Шамахы"], "e": "В Шамахы, центре региона Ширван."}, {"s": "Что такое «редиф» в классической восточной поэзии?", "o": ["Число строк", "Слово, повторяющееся после рифмы", "Название стихотворения", "Вид размера"], "e": "Это одно и то же слово или выражение, следующее за рифмой."}, {"s": "На чём основан размер аруз?", "o": ["На ударении", "На долготе и краткости слогов", "На рифме", "На количестве слогов"], "e": "Аруз — количественный размер."}, {"s": "На чём основан слоговой размер (хеджа)?", "o": ["На рифме", "На ударении", "На количестве слогов", "На долготе"], "e": "Народная поэзия написана слоговым размером."}, {"s": "На сколько языков переведены произведения Низами?", "o": ["Только на русский", "Только на тюркские языки", "Не переведены", "На десятки языков мира"], "e": "Наследие Низами — часть мировой литературы."}, {"s": "Какова структура «Сокровищницы тайн»?", "o": ["Письма", "Единый сюжет", "Диалоги", "Статья и соответствующий ей рассказ"], "e": "В каждой главе приводится наставление и подтверждающий его рассказ."}, {"s": "Что такое «бейт» в классической поэзии?", "o": ["Два полустишия", "Строфа", "Одно полустишие", "Четыре полустишия"], "e": "Бейт — единица, состоящая из двух полустиший."}]}, "Orta əsrlər poeziyası — 3-ci toplu": "Поэзия Средних веков — Сборник 3"}