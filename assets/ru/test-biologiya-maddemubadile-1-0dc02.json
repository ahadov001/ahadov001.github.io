{"__q": {"t": "Обмен веществ — Сборник 1", "q": [{"s": "Где происходит фотосинтез?", "o": ["Митохондрия", "Хлоропласт", "Ядро", "Рибосома"], "e": "Хлорофилл поглощает свет."}, {"s": "Что необходимо для фотосинтеза?", "o": ["Только тепло", "Только вода", "CO₂, вода, свет, хлорофилл", "Только кислород"], "e": "Без этих условий процесс не идёт."}, {"s": "Что является продуктом фотосинтеза?", "o": ["Глюкоза и кислород", "Только вода", "Только CO₂", "Белок"], "e": "6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂."}, {"s": "Что выделяется в процессе дыхания?", "o": ["Водород", "Азот", "Углекислый газ и энергия", "Кислород"], "e": "Органические вещества расщепляются."}, {"s": "Где протекает световая фаза фотосинтеза?", "o": ["В цитоплазме", "На мембранах тилакоидов", "В матриксе", "В ядре"], "e": "Здесь происходит фотолиз воды."}, {"s": "Где протекает темновая фаза (цикл Кальвина)?", "o": ["В митохондрии", "В строме хлоропласта", "В тилакоиде", "В ядре"], "e": "Происходит фиксация CO₂."}, {"s": "Где происходит гликолиз?", "o": ["В цитоплазме", "В митохондрии", "В хлоропласте", "В ядре"], "e": "Это бескислородный этап."}, {"s": "Сколько молекул АТФ (приблизительно) образуется из одной молекулы глюкозы при аэробном дыхании?", "o": ["100", "4", "2", "36–38"], "e": "При полном окислении."}, {"s": "Что такое анаэробное дыхание?", "o": ["Бескислородное расщепление", "С участием кислорода", "Синтез", "Фотосинтез"], "e": "Брожение — пример этого."}, {"s": "Что такое пластический обмен?", "o": ["Процессы синтеза (ассимиляция)", "Выделение", "Расщепление", "Дыхание"], "e": "Образуются сложные вещества."}]}, "Maddələr mübadiləsi — 1-ci toplu": "Обмен веществ — Сборник 1"}