{"__q": {"t": "Азербайджанская Демократическая Республика — Сборник 1", "q": [{"s": "Когда была провозглашена Азербайджанская Демократическая Республика?", "o": ["28 апреля 1920", "18 октября 1991", "12 ноября 1995", "28 мая 1918"], "e": "В Тифлисе была принята Декларация независимости."}, {"s": "Сколько месяцев существовала АДР?", "o": ["23", "12", "36", "6"], "e": "С мая 1918 года по апрель 1920 года."}, {"s": "Кто был первым премьер-министром АДР?", "o": ["Фатали хан Хойский", "М.Э.Расулзаде", "Нариман Нариманов", "Алимардан бек Топчибашев"], "e": "Возглавил первое правительство."}, {"s": "Кто был председателем Парламента АДР?", "o": ["Н.Нариманов", "Алимардан бек Топчибашев", "Ф.Х.Хойский", "М.Э.Расулзаде"], "e": "Был избран первым председателем парламента."}, {"s": "Чем АДР имеет историческое значение?", "o": ["Первая парламентская республика на мусульманском Востоке", "Первая монархия", "Первое ханство", "Первая империя"], "e": "Был избран демократический государственный строй."}, {"s": "Когда в АДР женщинам было предоставлено избирательное право?", "o": ["1991", "В 1918 году, раньше многих европейских стран", "Не предоставлено", "1920"], "e": "Это был важный демократический шаг."}, {"s": "Когда Баку стал столицей АДР?", "o": ["Никогда", "1920", "С сентября 1918 года", "Сразу"], "e": "Сначала временной столицей была Гянджа."}, {"s": "Когда был основан Бакинский государственный университет?", "o": ["1920", "1922", "1918", "1919"], "e": "Важное достижение правительства АДР."}, {"s": "Из скольких цветов состоит государственный флаг АДР?", "o": ["4", "2", "1", "3"], "e": "Голубой, красный, зелёный — у каждого цвета своё значение."}, {"s": "Что символизирует голубой цвет на флаге АДР?", "o": ["Ислам", "Тюркизм", "Землю", "Современность"], "e": "Красный — символ современности, зелёный — ислама."}]}, "Azərbaycan Xalq Cümhuriyyəti — 1-ci toplu": "Азербайджанская Демократическая Республика — Сборник 1"}