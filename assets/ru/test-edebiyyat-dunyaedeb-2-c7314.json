{"__q": {"t": "Мировая литература — Сборник 2", "q": [{"s": "Кто автор романа «Преступление и наказание»?", "o": ["Достоевский", "Толстой", "Чехов", "Горький"], "e": "Психологический роман Фёдора Достоевского."}, {"s": "Кто автор античного греческого эпоса «Илиада»?", "o": ["Еврипид", "Софокл", "Эсхил", "Гомер"], "e": "Рассказывает о Троянской войне."}, {"s": "О чём «Одиссея»?", "o": ["О торговле", "О любви", "О долгом пути героя домой", "О войне"], "e": "Десятилетнее странствие Одиссея."}, {"s": "В каком жанре писал Мольер?", "o": ["Поэма", "Трагедия", "Роман", "Комедия"], "e": "«Скупой», «Тартюф» — его комедии."}, {"s": "Чьё произведение «Шахнаме»?", "o": ["Саади", "Хафиза", "Омара Хайяма", "Фирдоуси"], "e": "Героический эпос персидской литературы."}, {"s": "В каком жанре известен Омар Хайям?", "o": ["Газель", "Касыда", "Рубаи", "Дастан"], "e": "Его философские рубаи известны всему миру."}, {"s": "Чьё произведение «Превращение» (Метаморфоза)?", "o": ["Сартра", "Кафки", "Камю", "Джойса"], "e": "Известная повесть Франца Кафки."}, {"s": "Чей роман «Сто лет одиночества»?", "o": ["Маркеса", "Борхеса", "Льосы", "Кортасара"], "e": "Габриэль Гарсиа Маркес — представитель магического реализма."}, {"s": "Что такое магический реализм?", "o": ["Исторический роман", "Сатира", "Научная фантастика", "Сочетание реальной жизни со сверхъестественными элементами"], "e": "Течение, характерное для литературы Латинской Америки."}, {"s": "Кто автор романа «Большие надежды»?", "o": ["Харди", "Остин", "Бронте", "Диккенс"], "e": "Чарльз Диккенс — классик английского реализма."}]}, "Dünya ədəbiyyatı — 2-ci toplu": "Мировая литература — Сборник 2"}