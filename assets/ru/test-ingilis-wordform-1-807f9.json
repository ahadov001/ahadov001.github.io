{"__q": {"t": "Word Formation — Сборник 1", "q": [{"s": "Form a noun from «happy».", "o": ["happily", "happiness", "happen", "happyness"], "e": "«-y» → «-iness»."}, {"s": "Form an adjective from «care».", "o": ["careless", "cared", "caring only", "carely"], "e": "«-less» выражает отсутствие."}, {"s": "Form a verb from «strong».", "o": ["strongen", "strength", "strengthen", "strongify"], "e": "«-en» образует глагол."}, {"s": "What does the prefix «un-» mean?", "o": ["before", "again", "too much", "not"], "e": "Выражает отрицание: unhappy."}, {"s": "What does the prefix «re-» mean?", "o": ["not", "again", "wrongly", "before"], "e": "Выражает повторность: rewrite."}, {"s": "Form a noun from «decide».", "o": ["decidence", "decisive", "decision", "deciding only"], "e": "Суффикс «-sion»."}, {"s": "Form an adverb from «happy».", "o": ["happily", "happyly", "happier", "happiness"], "e": "«-y» → «-ily»."}, {"s": "What does «-ful» mean?", "o": ["again", "full of", "not", "without"], "e": "Beautiful = полный красоты."}, {"s": "Form a noun from «teach».", "o": ["teaching only", "teachment", "teacher", "teachful"], "e": "Суффикс «-er» обозначает лицо."}, {"s": "What does the prefix «mis-» mean?", "o": ["again", "not", "before", "wrongly"], "e": "Misunderstand — неправильно понять."}]}, "Word Formation — 1-ci toplu": "Word Formation — Сборник 1"}