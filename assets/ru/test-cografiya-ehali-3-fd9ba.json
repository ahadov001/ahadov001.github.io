{"__q": {"t": "Население мира — Сборник 3", "q": [{"s": "Сколько примерно миллионов человек составляет население Азербайджана?", "o": ["3", "5", "10", "20"], "e": "Наблюдается постоянный рост."}, {"s": "Какова примерно доля городского населения в Азербайджане?", "o": ["20%", "10%", "более 53%", "90%"], "e": "Урбанизация продолжается."}, {"s": "Какая территория Азербайджана заселена наиболее густо?", "o": ["Вершины Большого Кавказа", "Апшерон и Кура-Араксинская низменность", "Гобустан", "Горная часть Нахчывана"], "e": "Сосредоточена экономическая деятельность."}, {"s": "С чем было связано вынужденное переселение в Азербайджане?", "o": ["Карабахский конфликт", "Климат", "Урбанизация", "Землетрясение"], "e": "Сотни тысяч людей были вынуждены покинуть свои дома."}, {"s": "Почему происходит трудовая миграция?", "o": ["Поиск работы и лучшего дохода", "Туризм", "Только образование", "Климат"], "e": "По экономическим причинам."}, {"s": "Что такое «утечка мозгов»?", "o": ["Рождаемость", "Урбанизация", "Выезд высококвалифицированных кадров за границу", "Рост населения"], "e": "Является проблемой для развития."}, {"s": "К чему приводит нарушение соотношения полов?", "o": ["Урбанизация", "Рост", "Не влияет", "Демографические и социальные проблемы"], "e": "Влияет на браки и рождаемость."}, {"s": "Что показывает средняя продолжительность жизни?", "o": ["Рождаемость", "Миграцию", "Уровень здравоохранения и жизни", "Климат"], "e": "Это показатель развития."}, {"s": "Что такое агломерация?", "o": ["Отдельный город", "Село", "Объединение центрального города и окружающих населённых пунктов", "Район"], "e": "Пример — Бакинская агломерация."}, {"s": "Для чего проводится перепись населения?", "o": ["Карта", "Туризм", "Только налоги", "Сбор точных статистических данных о населении"], "e": "Для государственного планирования."}]}, "Dünya əhalisi — 3-ci toplu": "Население мира — Сборник 3"}