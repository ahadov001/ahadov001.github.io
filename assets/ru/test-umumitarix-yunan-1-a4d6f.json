{"__q": {"t": "Древняя Греция — Сборник 1", "q": [{"s": "Как назывался город-государство в Древней Греции?", "o": ["Ном", "Республика", "Полис", "Сатрапия"], "e": "Самые известные — Афины и Спарта."}, {"s": "Какая форма правления возникла в Афинах?", "o": ["Монархия", "Демократия", "Теократия", "Деспотизм"], "e": "Основным органом было народное собрание."}, {"s": "Чем была известна Спарта?", "o": ["Театром", "Торговлей", "Военным воспитанием и сильной армией", "Философией"], "e": "Суровый образ жизни."}, {"s": "Какая битва известна в греко-персидских войнах?", "o": ["Гасанлы", "Зама", "Канны", "Марафонская"], "e": "Афиняне одержали победу."}, {"s": "С кем связывают битву при Фермопилах?", "o": ["Перикл", "Леонид и 300 спартанцев", "Дракон", "Солон"], "e": "Стала символом героизма."}, {"s": "Чем известна эпоха Перикла?", "o": ["Упадком", "Золотым веком Афин", "Голодом", "Войной"], "e": "Был построен Парфенон."}, {"s": "С какой целью проводились Олимпийские игры?", "o": ["Политической", "Военной", "Спортивный праздник в честь Зевса", "Торговой"], "e": "Раз в четыре года."}, {"s": "Кто такие Сократ, Платон, Аристотель?", "o": ["Поэты", "Полководцы", "Правители", "Философы"], "e": "Основа западной философии."}, {"s": "Кого называют Геродотом?", "o": ["Философ", "Поэт", "Математик", "«Отец истории»"], "e": "Описал греко-персидские войны."}, {"s": "Между кем шла Пелопоннесская война?", "o": ["Греками и персами", "Римом и Карфагеном", "Египтом и Ассирией", "Афинами и Спартой"], "e": "Ослабила Грецию."}]}, "Qədim Yunanıstan — 1-ci toplu": "Древняя Греция — Сборник 1"}