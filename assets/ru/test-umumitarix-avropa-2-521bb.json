{"__q": {"t": "Европа в Средние века — Сборник 2", "q": [{"s": "Что такое Ганзейский союз?", "o": ["Объединение торговых городов Северной Европы", "Военный блок", "Религиозный союз", "Университет"], "e": "Управлял балтийской торговлей."}, {"s": "Что такое инквизиция?", "o": ["Церковный орган религиозного суда", "Судебная система", "Армия", "Налог"], "e": "Была направлена против еретиков."}, {"s": "Как называлась личная зависимость крестьян?", "o": ["Вассалитет", "Крепостное право", "Гильдия", "Цех"], "e": "Была привязана к земле."}, {"s": "Против чего были направлены восстания Жакерия и Уота Тайлера?", "o": ["Против церкви", "Против короля", "Против купцов", "Против феодального гнёта и налогов"], "e": "Во Франции и Англии."}, {"s": "К чему привело распространение пороха и огнестрельного оружия в Европе?", "o": ["К изоляции", "Ни к каким изменениям", "К снижению значения рыцарского войска и замков", "К усилению феодализма"], "e": "Военное дело изменилось."}, {"s": "Кто изобрёл печатный станок?", "o": ["Колумб", "Людовик", "Лютер", "Гутенберг"], "e": "Середина XV века."}, {"s": "Каково было значение книгопечатания?", "o": ["Распространение книг, рост грамотности", "Не оказало влияния", "Сокращение торговли", "Усиление церкви"], "e": "Информационная революция."}, {"s": "От кого Нидерланды добились независимости в конце XVI века?", "o": ["От Испании", "От Англии", "От Османской империи", "От Франции"], "e": "Одна из первых буржуазных революций."}, {"s": "Какая страна позднее получила название «мастерская мира»?", "o": ["Испания", "Англия", "Франция", "Италия"], "e": "После промышленной революции."}, {"s": "Что такое меркантилизм?", "o": ["Феодализм", "Политика государства, направленная на увеличение экспорта и ограничение импорта", "Крепостное право", "Свободная торговля"], "e": "Основан на накоплении драгоценных металлов."}]}, "Orta əsrlərdə Avropa — 2-ci toplu": "Европа в Средние века — Сборник 2"}