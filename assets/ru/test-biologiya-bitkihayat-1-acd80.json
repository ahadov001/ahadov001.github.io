{"__q": {"t": "Жизнедеятельность растений — Сборник 1", "q": [{"s": "С помощью чего осуществляется минеральное питание растений?", "o": ["Листом", "Корневыми волосками", "Цветком", "Плодом"], "e": "Поглощается из почвенного раствора."}, {"s": "Какие макроэлементы наиболее важны для растения?", "o": ["Золото, серебро", "Йод, фтор", "Азот, фосфор, калий", "Железо, цинк"], "e": "Составляют основу NPK-удобрений."}, {"s": "Что наблюдается у растения при недостатке азота?", "o": ["Быстрый рост", "Никаких изменений", "Пожелтение листьев и слабый рост", "Много плодов"], "e": "Нарушается синтез хлорофилла."}, {"s": "Что способствует подъёму воды по растению вверх?", "o": ["Только сила тяжести", "Ветер", "Корневое давление и присасывающая сила транспирации", "Фотосинтез"], "e": "Две силы действуют вместе."}, {"s": "Как называются движения растений?", "o": ["Миграция", "Тропизмы и настии", "Рефлекс", "Рефлексы"], "e": "Ростовые движения, направленные на внешний фактор."}, {"s": "Что такое фототропизм?", "o": ["Рост по направлению к воде", "Рост по направлению к свету", "Прикосновение", "Реакция на силу тяжести"], "e": "Стебель проявляет положительный фототропизм."}, {"s": "Что такое геотропизм?", "o": ["Реакция на силу тяжести", "Реакция на свет", "Реакция на воду", "На тепло"], "e": "Корень проявляет положительный геотропизм."}, {"s": "Как называются растительные гормоны?", "o": ["Фитогормоны", "Витамины", "Антибиотики", "Ферменты"], "e": "Ауксин, гиббереллин и др."}, {"s": "Кто предложил бинарную номенклатуру в систематике растений?", "o": ["Дарвин", "Карл Линней", "Геккель", "Мендель"], "e": "Название рода + название вида."}, {"s": "Каковы жизненные формы растений?", "o": ["Только кустарник", "Только дерево", "Только трава", "Дерево, кустарник, трава"], "e": "Деление по строению."}]}, "Bitkilərin həyat fəaliyyəti — 1-ci toplu": "Жизнедеятельность растений — Сборник 1"}