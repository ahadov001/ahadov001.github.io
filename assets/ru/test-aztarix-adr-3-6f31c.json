{"__q": {"t": "Азербайджанская Демократическая Республика — Сборник 3", "q": [{"s": "Какова основная причина падения АДР?", "o": ["Стихийное бедствие", "Экономический кризис", "Внутреннее восстание", "Военное вторжение Советской России"], "e": "XI Красная армия вошла в Баку."}, {"s": "Какие государственные органы были созданы в период АДР?", "o": ["Парламент, правительство, суд, финансовая система", "Только парламент", "Только армия", "Никаких"], "e": "Был создан полноценный государственный аппарат."}, {"s": "Сколько партий было представлено в Парламенте АДР?", "o": ["1", "2", "Несколько, а также национальные меньшинства", "Партий не было"], "e": "Существовала многопартийная система."}, {"s": "Как отмечается 28 Мая в Азербайджане?", "o": ["День независимости (День Республики)", "День Конституции", "День флага", "День Победы"], "e": "Это дата провозглашения АДР."}, {"s": "Как были приняты символы АДР в независимом Азербайджане?", "o": ["Отвергнуты", "Изменены", "Восстановлены флаг, герб и гимн", "Забыты"], "e": "В 1991 году было объявлено правопреемство."}, {"s": "Какой была ситуация в Карабахе в период АДР?", "o": ["Проблем не было", "Конфликтной", "Неизвестной", "Спокойной"], "e": "Существовали территориальные споры."}, {"s": "В чём заключалась миссия Топчибашева на Парижской конференции?", "o": ["Эмиграция", "Торговля", "Добиться международного признания АДР", "Военная помощь"], "e": "Предпринимал дипломатические усилия."}, {"s": "Каково историческое наследие АДР?", "o": ["Только военное", "Отсутствует", "Только экономическое", "Опыт независимой государственности и демократии"], "e": "Современный Азербайджан — её преемник."}, {"s": "С какой страной АДР была в тесных отношениях?", "o": ["Османская Турция", "Франция", "Англия", "Россия"], "e": "Кавказская исламская армия участвовала в освобождении Баку."}, {"s": "Кто командовал Кавказской исламской армией?", "o": ["Талаат-паша", "Нури-паша", "Энвер-паша", "Мустафа Кемаль"], "e": "В 1918 году помог освободить Баку."}]}, "Azərbaycan Xalq Cümhuriyyəti — 3-ci toplu": "Азербайджанская Демократическая Республика — Сборник 3"}