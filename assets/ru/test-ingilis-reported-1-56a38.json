{"__q": {"t": "Косвенная речь — Сборник 1", "q": [{"s": "Report: «I am tired,» he said.", "o": ["He said he was tired.", "He says he was tired.", "He said he is tired.", "He said he had tired."], "e": "Время сдвигается на ступень назад."}, {"s": "Report: «I will come,» she said.", "o": ["She said she will come.", "She said she had come.", "She said she comes.", "She said she would come."], "e": "will → would."}, {"s": "Report: «Where do you live?» he asked.", "o": ["He asked where did I live.", "He asked where I lived.", "He asked where do I live.", "He asked where I live?"], "e": "В косвенном вопросе порядок слов как в повествовательном предложении."}, {"s": "Report: «Close the door,» she said.", "o": ["She told me to close the door.", "She said to closing the door.", "She told close the door.", "She said close the door."], "e": "Приказ → tell + to + инфинитив."}, {"s": "Report: «Don't go,» he said.", "o": ["He said not go.", "He told me don't go.", "He told me to not going.", "He told me not to go."], "e": "Отрицательный приказ: not + to + инфинитив."}, {"s": "In reported speech «yesterday» becomes:", "o": ["tomorrow", "today", "the day before", "yesterday"], "e": "Обстоятельства времени меняются."}, {"s": "In reported speech «now» becomes:", "o": ["soon", "then", "today", "now"], "e": "Наречие времени меняется."}, {"s": "Report: «Did you see him?» she asked.", "o": ["She asked if I had seen him.", "She asked if did I see him.", "She asked did I see him.", "She asked I saw him."], "e": "Общий вопрос → if/whether."}, {"s": "In reported speech «this» becomes:", "o": ["it", "that", "this", "these"], "e": "Указательное местоимение меняется."}, {"s": "Report: «I have finished,» he said.", "o": ["He said he finished.", "He said he has finished.", "He said he will finish.", "He said he had finished."], "e": "Present Perfect → Past Perfect."}]}, "Reported Speech — 1-ci toplu": "Косвенная речь — Сборник 1"}