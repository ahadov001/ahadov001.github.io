{"__q": {"t": "Уравнения — Сборник 2", "q": [{"s": "Каковы корни уравнения x² − 4 = 0?", "o": ["2 и −2", "2", "4", "−2"], "e": "x² = 4 → x = ±2."}, {"s": "Чему равен корень уравнения x² + 2x + 1 = 0?", "o": ["−1", "1", "Корней нет", "2"], "e": "(x+1)² = 0 → x = −1 (двукратный корень)."}, {"s": "Если 2x + 3y = 12 и x = 3, чему равно y?", "o": ["4", "1", "3", "2"], "e": "6 + 3y = 12 → y = 2."}, {"s": "Что значит решить систему уравнений?", "o": ["Решить одно уравнение", "Построить график", "Упростить", "Найти значения, удовлетворяющие обоим уравнениям одновременно"], "e": "Ищется общее решение."}, {"s": "Чему равен x в системе x + y = 10, x − y = 4?", "o": ["7", "3", "5", "6"], "e": "Метод сложения: 2x = 14 → x = 7."}, {"s": "Чему не может быть равно a в уравнении ax² + bx + c = 0?", "o": ["−1", "Любое значение", "1", "0"], "e": "При a=0 уравнение не будет квадратным."}, {"s": "Чему равен корень уравнения x² = 0?", "o": ["Корней нет", "±1", "Бесконечность", "0"], "e": "Только x=0."}, {"s": "Чему равен корень уравнения 5x − 2 = 3x + 8?", "o": ["2", "3", "5", "10"], "e": "2x = 10 → x = 5."}, {"s": "Каковы корни уравнения x² − 7x = 0?", "o": ["0 и 7", "−7", "0", "7"], "e": "x(x−7) = 0."}, {"s": "Какова формула корней квадратного уравнения?", "o": ["x = (−b ± √D)/2a", "x = D/2a", "x = b/2a", "x = −b ± √D"], "e": "Стандартная формула корней."}]}, "Tənliklər — 2-ci toplu": "Уравнения — Сборник 2"}