{"__q": {"t": "Буржуазные революции — Сборник 2", "q": [{"s": "Каким сражением завершилось поражение Наполеона?", "o": ["Бородино", "Лейпциг", "Ватерлоо (1815)", "Аустерлиц"], "e": "Против сил союзников."}, {"s": "Чем закончился поход Наполеона в Россию 1812 года?", "o": ["Миром", "Победой", "Безрезультатно", "Тяжёлым поражением"], "e": "Большая часть его армии погибла."}, {"s": "С какой целью был проведён Венский конгресс (1815)?", "o": ["Религия", "Торговля", "Установление европейского порядка после Наполеона", "Начало войны"], "e": "Был создан «Священный союз»."}, {"s": "Чем важен Кодекс Наполеона?", "o": ["Налоговый закон", "Религиозный закон", "Заложил современные основы гражданского права", "Военный устав"], "e": "Повлиял на многие страны."}, {"s": "Как называются революции 1848 года?", "o": ["Промышленные", "Славная революция", "Октябрьская", "«Весна народов»"], "e": "Охватили Европу."}, {"s": "Из-за чего началась гражданская война в США (1861–1865)?", "o": ["Из-за земли", "Из-за рабства и сохранения союза", "Из-за религии", "Из-за границы"], "e": "Победил Север."}, {"s": "Чем известен Авраам Линкольн?", "o": ["Отменой рабства и сохранением союза", "Империя", "Независимость", "Открытие"], "e": "Прокламация об освобождении рабов."}, {"s": "С чьими именами связано объединение Италии?", "o": ["Бисмарк", "Меттерних", "Наполеон III", "Гарибальди и Кавур"], "e": "1861–1870 гг."}, {"s": "Кто осуществил объединение Германии?", "o": ["Вильгельм I в одиночку", "Меттерних", "Отто фон Бисмарк", "Гитлер"], "e": "Политика «железа и крови»."}, {"s": "Кто возглавил движение за независимость в Латинской Америке?", "o": ["Гарибальди", "Кромвель", "Симон Боливар", "Вашингтон"], "e": "Против испанского колониализма."}]}, "Burjua inqilabları — 2-ci toplu": "Буржуазные революции — Сборник 2"}