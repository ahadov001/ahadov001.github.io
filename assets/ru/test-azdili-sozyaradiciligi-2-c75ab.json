{"__q": {"t": "Словообразование — Сборник 2", "q": [{"s": "Каково слово «kitablar» по структуре?", "o": ["Сложное", "Простое", "Производное", "Заимствованное"], "e": "«-lar» — грамматический аффикс, нового слова не образует."}, {"s": "Каково слово «kitabça» по структуре?", "o": ["Повторное", "Простое", "Производное", "Сложное"], "e": "«-ça» — лексический аффикс, образовал новое слово."}, {"s": "Как отличить лексический аффикс от грамматического?", "o": ["По тому, меняет ли он значение слова", "По длине", "По ударению", "По месту"], "e": "Лексический аффикс образует новое слово."}, {"s": "Сколько аффиксов в слове «işçilərimizdən»?", "o": ["5", "3", "2", "4"], "e": "çi + lər + imiz + dən = 4 аффикса."}, {"s": "Какой аффикс образует существительное со значением профессии?", "o": ["-çı, -çi", "-lıq", "-lı", "-sız"], "e": "Yazıçı, dəmirçi, ovçu."}, {"s": "Как образовано слово «günəbaxan»?", "o": ["Повтором", "Соединением двух корней", "Аффиксом", "Сокращением"], "e": "Это сложное слово."}, {"s": "Какое слово является производным?", "o": ["evlər", "evli", "ev", "evdə"], "e": "«-li» — лексический аффикс."}, {"s": "Что такое морфологический способ словообразования?", "o": ["Сокращение", "Присоединение аффикса", "Соединение слов", "Изменение значения"], "e": "İş → işçi."}, {"s": "Каким способом образовано «BDU»?", "o": ["Сокращением", "Лексико-семантическим", "Морфологическим", "Синтаксическим"], "e": "Аббревиатура из начальных букв."}, {"s": "В каком ряду только производные слова?", "o": ["dəmiryolu, günəbaxan", "dostluq, yazıçı, gözlük", "ev, su, daş", "kitablar, evdə"], "e": "Все образованы лексическим аффиксом."}, {"s": "Как образуется сложное слово?", "o": ["Аффиксом", "Сокращением", "Из двух и более корней", "Из одного корня"], "e": "Dəmiryolu, boyunbağı."}, {"s": "Что образует аффикс «-laş, -ləş»?", "o": ["Глагол взаимного залога", "Существительное", "Прилагательное", "Наречие"], "e": "Dostlaş, salamlaş."}]}, "Söz yaradıcılığı — 2-ci toplu": "Словообразование — Сборник 2"}