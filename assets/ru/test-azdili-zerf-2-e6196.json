{"__q": {"t": "Наречие — Сборник 2", "q": [{"s": "Какое наречие «Yavaş-yavaş» по строению?", "o": ["Заимствованное", "Производное", "Сложное", "Простое"], "e": "Сложное наречие, образованное повтором."}, {"s": "Какой суффикс есть в слове «Gizlincə»?", "o": ["-cə", "-ncə", "-incə", "-lincə"], "e": "К прилагательному «gizli» добавлен суффикс «-ncə» (вариант «-cə»), и образовалось наречие."}, {"s": "Какое слово НЕ является наречием?", "o": ["gözəl mənzərə", "tez", "indi", "burada"], "e": "«Gözəl mənzərə» — словосочетание, а не наречие."}, {"s": "Что такое «sürətlə» в выражении «Sürətlə qaçdı»?", "o": ["Существительное", "Глагол", "Наречие", "Прилагательное"], "e": "Наречие образа действия, образованное суффиксом «-la»."}, {"s": "Сколько разрядов наречий по значению?", "o": ["4", "5", "3", "6"], "e": "Образа действия, времени, места, меры и степени, причины и цели."}, {"s": "К какому разряду наречий относится «nahaq» в предложении «Nahaq yerə gözlədim»?", "o": ["Места", "Причины и цели", "Времени", "Меры и степени"], "e": "Указывает, что действие было напрасным."}, {"s": "Какое наречие не является производным?", "o": ["yavaşca", "diqqətlə", "dostcasına", "tez"], "e": "«Tez» состоит из одного корня — это простое наречие."}, {"s": "Как пишется выражение «Bu gün»?", "o": ["через дефис", "раздельно", "возможен любой вариант", "слитно"], "e": "«Bu gün» пишется раздельно; написание «bugün» неверно."}, {"s": "На что нужно смотреть, чтобы отличить наречие от прилагательного?", "o": ["На длину слова", "На то, что следует за словом — существительное или глагол", "На суффикс", "На ударение"], "e": "Если следует существительное — это прилагательное, если глагол — наречие."}, {"s": "Что обозначает наречие «Gündən-günə»?", "o": ["Место", "Причину", "Образ действия", "Время"], "e": "Обозначает постепенное изменение во времени."}, {"s": "В каком предложении есть наречие?", "o": ["Gözəl ev tikdilər.", "Tez gəldilər.", "Qırmızı gül açdı.", "Beş kitab aldım."], "e": "«Tez» поясняет глагол — это наречие."}, {"s": "Какой суффикс стоит в конце слова «Təsadüfən»?", "o": ["-ən", "-fən", "-dən", "-sən"], "e": "Добавлением «-ən» к заимствованным корням образуются наречия."}]}, "Zərf — 2-ci toplu": "Наречие — Сборник 2"}