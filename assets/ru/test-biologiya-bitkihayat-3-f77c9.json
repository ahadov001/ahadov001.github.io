{"__q": {"t": "Жизнедеятельность растений — Сборник 3", "q": [{"s": "Что такое вегетационный период?", "o": ["Период активного роста и развития растения", "Смерть", "Зимний покой", "Период семени"], "e": "Зависит от климата."}, {"s": "В какой группе растений нет проводящей системы?", "o": ["Папоротники", "Голосеменные", "Мхи", "Покрытосеменные"], "e": "Имеют примитивное строение."}, {"s": "Что такое фотопериодизм?", "o": ["Реакция на длину дня", "Реакция на цвет света", "Реакция на тепло", "Реакция на воду"], "e": "Определяет время цветения."}, {"s": "Что такое прививка?", "o": ["Соединение части одного растения с другим", "Селекция", "Размножение семенами", "Мутация"], "e": "Широко используется в плодоводстве."}, {"s": "Для чего растениям нужен зимний покой?", "o": ["Для питания", "Для размножения", "Для защиты от неблагоприятных условий", "Для роста"], "e": "Обмен веществ замедляется."}, {"s": "Что такое гербарий?", "o": ["Банк семян", "Лаборатория", "Коллекция засушенных растений", "Сад"], "e": "Используется для научных исследований."}, {"s": "Какое растение занесено в Красную книгу Азербайджана?", "o": ["Пшеница", "Помидор", "Картофель", "Сосна эльдарская"], "e": "Редкий и исчезающий вид."}, {"s": "Когда дыхание растений проявляется сильнее всего?", "o": ["Никогда", "Только зимой", "Днём", "Ночью (при отсутствии фотосинтеза)"], "e": "Днём преобладает фотосинтез."}, {"s": "Что такое гидропоника?", "o": ["Посев в почву", "Внесение удобрений", "Способ полива", "Выращивание растений без почвы, в питательном растворе"], "e": "Современная агротехнология."}, {"s": "Какая группа растений самая распространённая?", "o": ["Покрытосеменные", "Мхи", "Папоротники", "Водоросли"], "e": "Насчитывает более 250 тысяч видов."}]}, "Bitkilərin həyat fəaliyyəti — 3-ci toplu": "Жизнедеятельность растений — Сборник 3"}