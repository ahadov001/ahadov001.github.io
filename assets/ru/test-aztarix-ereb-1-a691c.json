{"__q": {"t": "Период Арабского халифата — Сборник 1", "q": [{"s": "Когда арабы начали завоевание Азербайджана?", "o": ["VI век", "XI век", "IX век", "VII век"], "e": "В середине VII века."}, {"s": "В каком веке происходило движение Бабека?", "o": ["XI век", "VII век", "XIII век", "IX век"], "e": "Охватывает 816–838 годы."}, {"s": "Руководителем какого движения был Бабек?", "o": ["Шуубитов", "Хариджитов", "Хуррамитов", "Карматов"], "e": "Возглавил движение хуррамитов."}, {"s": "Какая крепость была ставкой Бабека?", "o": ["Гюлюстан", "Чыраггала", "Крепость Баз", "Алинджа"], "e": "Находилась в горах Карадаг."}, {"s": "Сколько лет продолжалось движение Бабека?", "o": ["5", "40", "10", "более 20"], "e": "Примерно 22 года."}, {"s": "Какая религия распространилась в Азербайджане после арабского завоевания?", "o": ["Зороастризм", "Ислам", "Христианство", "Буддизм"], "e": "Ислам постепенно стал основной религией."}, {"s": "Какой налог взимался с Азербайджана в период Халифата?", "o": ["Налогов не было", "Джизья и харадж", "Только товарами", "Только деньгами"], "e": "Джизья — с немусульман, харадж — поземельный налог."}, {"s": "Кто разгромил Бабека?", "o": ["Марван", "Харун ар-Рашид", "Мутаваккил", "Афшин"], "e": "Полководец халифа Мутасима Афшин."}, {"s": "Какова была основная причина борьбы против арабского завоевания?", "o": ["Тяжёлые налоги и социальный гнёт", "Религиозные различия", "Торговля", "Язык"], "e": "Экономическая эксплуатация была главным фактором."}, {"s": "Какой язык был официальным в Азербайджане в период Халифата?", "o": ["Арабский", "Тюркский", "Персидский", "Албанский"], "e": "В государственных делах использовался арабский язык."}]}, "Ərəb xilafəti dövrü — 1-ci toplu": "Период Арабского халифата — Сборник 1"}