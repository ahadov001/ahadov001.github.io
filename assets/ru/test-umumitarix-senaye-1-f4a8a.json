{"__q": {"t": "Промышленная революция — Сборник 1", "q": [{"s": "В какой стране началась промышленная революция?", "o": ["Англия", "Франция", "США", "Германия"], "e": "Вторая половина XVIII века."}, {"s": "В чём суть промышленной революции?", "o": ["Изоляция", "Феодализм", "Возврат к ручному труду", "Переход к машинному производству"], "e": "Возникла фабричная система."}, {"s": "Кто усовершенствовал паровую машину?", "o": ["Джеймс Уатт", "Эдисон", "Ньютон", "Фарадей"], "e": "Стала двигателем промышленности."}, {"s": "В какой отрасли началась промышленная революция?", "o": ["Текстильная промышленность", "Металлургия", "Химия", "Машиностроение"], "e": "Прядильные и ткацкие машины."}, {"s": "Кто создал первый паровоз?", "o": ["Джордж Стефенсон", "Эдисон", "Фултон", "Уатт"], "e": "Начало железнодорожного транспорта."}, {"s": "Каким было социальное последствие промышленной революции?", "o": ["Рабство", "Возникновение рабочего класса и промышленной буржуазии", "Феодализм", "Никаких изменений"], "e": "Города стремительно росли."}, {"s": "Как урбанизация связана с промышленной революцией?", "o": ["Сократила", "Фабрики вызвали приток населения в города", "Превратила в сёла", "Не связана"], "e": "Условия жизни были тяжёлыми."}, {"s": "Против чего было направлено движение луддитов?", "o": ["Против машин (как причины безработицы)", "Против налогов", "Против короля", "Против церкви"], "e": "Протест рабочих в Англии."}, {"s": "Для чего были созданы профсоюзы?", "o": ["Для защиты прав рабочих", "Для государственного управления", "Для религии", "Для торговли"], "e": "Улучшение условий труда."}, {"s": "Чем характеризуется вторая промышленная революция?", "o": ["Паром", "Ручным трудом", "Компьютером", "Электричеством, двигателем внутреннего сгорания, химической промышленностью"], "e": "Конец XIX — начало XX века."}]}, "Sənaye inqilabı — 1-ci toplu": "Промышленная революция — Сборник 1"}