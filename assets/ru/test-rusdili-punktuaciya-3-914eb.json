{"__q": {"t": "Пунктуация — Сборник 3", "q": [{"s": "Где нужна запятая: «Я знаю что ты придёшь»?", "o": ["после «знаю что»", "не нужна", "перед «что»", "в конце"], "e": "Сложноподчинённое предложение."}, {"s": "Где нужна запятая: «Он устал но продолжал работать»?", "o": ["перед «но»", "не нужна", "в конце", "после «но»"], "e": "Противопоставление."}, {"s": "Нужна ли запятая: «Мальчик читает и пишет»?", "o": ["нет", "да, перед и", "двоеточие", "да, после и"], "e": "Два однородных сказуемых."}, {"s": "Какой знак нужен: «Утро прекрасное время дня»?", "o": ["ничего", "запятая", "тире", "двоеточие"], "e": "Два существительных в именительном падеже."}, {"s": "Какой знак нужен: «Я увидел ночь была тихая»?", "o": ["точка", "двоеточие", "тире", "запятая"], "e": "Вторая часть поясняет первую."}, {"s": "Запятая при однородных членах с повторяющимся союзом «и»:", "o": ["ставится", "не ставится", "двоеточие", "иногда"], "e": "«И книги, и ручки, и тетради»."}, {"s": "В предложении «Конечно я приду» нужна...", "o": ["запятая после «конечно»", "двоеточие", "тире", "точка только"], "e": "Вводное слово выделяется запятыми."}, {"s": "Знак в конце: «Как красиво здесь»", "o": ["вопросительный знак", "многоточие", "восклицательный знак", "точка"], "e": "Это восклицательное предложение."}, {"s": "Нужно ли тире: «Дважды два четыре»?", "o": ["запятая", "двоеточие", "да", "нет"], "e": "Тире между числительными."}, {"s": "Главная функция знаков препинания:", "o": ["передача структуры и смысла предложения", "украшение текста", "увеличение объёма", "нет функции"], "e": "Точная передача смысла."}]}, "Пунктуация — 3-ci toplu": "Пунктуация — Сборник 3"}