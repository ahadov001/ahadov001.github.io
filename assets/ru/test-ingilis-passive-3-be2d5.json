{"__q": {"t": "Пассивный залог — Сборник 3", "q": [{"s": "Change to passive: «People say he is rich.»", "o": ["It says he rich.", "He is saying rich.", "He is said to be rich.", "He says to be rich."], "e": "Безличная пассивная конструкция."}, {"s": "Complete: «It ___ that the meeting will be cancelled.»", "o": ["believed", "believes", "is believed", "is believing"], "e": "Конструкция «It is believed that …»."}, {"s": "Choose: «The house ___ being built.»", "o": ["will", "has", "is", "was"], "e": "Present Continuous Passive."}, {"s": "Complete: «The problem needs ___ .»", "o": ["to solving", "solved", "solving", "solve"], "e": "«Need» + герундий придаёт пассивное значение."}, {"s": "Choose the active form: «The window was broken by him.»", "o": ["He broke the window.", "He breaks the window.", "The window broke.", "He is breaking it."], "e": "Преобразование из пассивного залога в активный."}, {"s": "Complete: «I ___ to the party.»", "o": ["am inviting", "was invited", "invite", "invited"], "e": "Меня пригласили."}, {"s": "Choose: «The road is ___ repaired.»", "o": ["being", "be", "to be", "been"], "e": "Конструкция Present Continuous Passive."}, {"s": "Complete: «The exam results ___ tomorrow.»", "o": ["will be announced", "announced", "announce", "are announcing"], "e": "Future Passive."}, {"s": "Which sentence cannot be made passive?", "o": ["They built a house.", "She arrived late.", "He wrote a book.", "We saw him."], "e": "Непереходные глаголы не преобразуются в пассивный залог."}, {"s": "Complete: «The letter ___ to be sent yesterday.»", "o": ["is supposing", "supposes", "was supposed", "supposed"], "e": "Конструкция «be supposed to»."}]}, "Passive Voice — 3-ci toplu": "Пассивный залог — Сборник 3"}