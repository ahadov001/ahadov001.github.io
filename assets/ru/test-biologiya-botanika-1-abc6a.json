{"__q": {"t": "Строение растений — Сборник 1", "q": [{"s": "Какова основная функция корня?", "o": ["Дыхание", "Поглощение воды и минеральных веществ, закрепление растения", "Размножение", "Фотосинтез"], "e": "Обеспечивает питание из почвы."}, {"s": "Сколько существует типов корневых систем?", "o": ["4", "3", "1", "2"], "e": "Стержневая и мочковатая корневая система."}, {"s": "Какова основная функция листа?", "o": ["Фотосинтез, транспирация, газообмен", "Закрепление", "Размножение", "Поглощение воды"], "e": "«Кухня» растения."}, {"s": "Где расположены устьица?", "o": ["Только в стебле", "В цветке", "В эпидермисе листа", "В корне"], "e": "Регулируют газообмен."}, {"s": "Какова функция стебля?", "o": ["Только фотосинтез", "Только опора", "Размножение", "Опора, транспорт веществ, иногда накопление запасов"], "e": "Несёт листья и цветки."}, {"s": "Каковы основные части цветка?", "o": ["Лист", "Тычинка, пестик, лепесток, чашелистик", "Только пестик", "Только лепесток"], "e": "Орган размножения."}, {"s": "Что такое опыление?", "o": ["Созревание плода", "Попадание пыльцы на рыльце пестика", "Оплодотворение", "Образование семени"], "e": "Этап, предшествующий оплодотворению."}, {"s": "Из чего развивается плод?", "o": ["Из лепестка", "Из завязи", "Из тычинки", "Из чашелистика"], "e": "Защищает и распространяет семена."}, {"s": "Из чего состоит семя?", "o": ["Только из кожуры", "Из зародыша, запасных питательных веществ, кожуры", "Только из зародыша", "Из корня"], "e": "Начало нового растения."}, {"s": "Что такое камбий?", "o": ["Цветок", "Ткань листа", "Корень", "Ткань, обеспечивающая рост стебля в толщину"], "e": "Образовательная ткань."}]}, "Bitkilərin quruluşu — 1-ci toplu": "Строение растений — Сборник 1"}