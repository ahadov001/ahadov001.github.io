{"__q": {"t": "Пунктуация — Сборник 2", "q": [{"s": "Запятая перед «но» ставится...", "o": ["только в конце", "всегда", "иногда", "никогда"], "e": "Противительный союз."}, {"s": "Запятая перед «и» ставится, если он соединяет...", "o": ["никогда", "всегда", "два однородных члена", "части сложного предложения"], "e": "В сложном предложении."}, {"s": "Обращение в начале предложения выделяется...", "o": ["тире", "двоеточием", "запятой", "ничем"], "e": "«Мама, я дома»."}, {"s": "Вводное слово в середине предложения выделяется...", "o": ["запятыми с двух сторон", "тире", "одной запятой", "ничем"], "e": "«Он, кажется, прав»."}, {"s": "Причастный оборот перед определяемым словом...", "o": ["в кавычках", "в скобках", "не выделяется (обычно)", "выделяется"], "e": "«Лежащая на столе книга»."}, {"s": "Деепричастный оборот...", "o": ["выделяется запятыми", "в скобках", "в кавычках", "не выделяется"], "e": "Независимо от положения."}, {"s": "В каком случае ставится восклицательный знак?", "o": ["нейтральное сообщение", "вопрос", "выражение сильного чувства или побуждения", "перечисление"], "e": "Восклицательное предложение."}, {"s": "Запятая не ставится перед «как», если оборот...", "o": ["вводный", "входит в состав сказуемого («он как брат мне»)", "сравнительный", "уточняющий"], "e": "Различается по смыслу."}, {"s": "Тире ставится перед обобщающим словом, если оно стоит...", "o": ["после однородных членов", "в кавычках", "в начале", "перед однородными членами"], "e": "«Книги, ручки — всё здесь»."}, {"s": "Знаки препинания при прямой речи после неё:", "o": ["запятая (или ? !) и тире перед словами автора", "только точка", "двоеточие", "ничего"], "e": "«\"Иду\", — сказал он»."}]}, "Пунктуация — 2-ci toplu": "Пунктуация — Сборник 2"}