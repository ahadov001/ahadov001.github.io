{"__q": {"t": "Культура текста и речи — Сборник 3", "q": [{"s": "Что означает признак «цельность» текста?", "o": ["Предложения короткие", "Текст длинный", "Все предложения служат одной теме", "Нет абзацев"], "e": "Предложение, выходящее за рамки темы, нарушает цельность текста."}, {"s": "В каком ряду правильно названы типы речи?", "o": ["описание, повествование, рассуждение", "простое, сложное", "художественный, научный, бытовой", "вступление, основная часть, заключение"], "e": "Это типы речи; остальное — структура и стили."}, {"s": "Какая особенность не свойственна научному стилю?", "o": ["Логичность", "Термины", "Точность", "Метафоры и образность"], "e": "Образность присуща художественному стилю."}, {"s": "Как называется ошибка в выражении «Aşağı enmək»?", "o": ["Плеоназм", "Тавтология", "Диалектизм", "Архаизм"], "e": "Употребление лишнего слова — это плеоназм."}, {"s": "Для чего в тексте используется абзац?", "o": ["Чтобы занять место", "Чтобы показать начало новой мысли", "Чтобы красиво выглядело", "Правил нет"], "e": "Абзац разделяет логические части текста."}, {"s": "В каком типе текста есть доказательство и вывод?", "o": ["Описание", "Рассуждение", "Повествование", "Диалог"], "e": "Рассуждение имеет структуру тезис → доказательство → вывод."}, {"s": "Что подразумевает требование «богатство» речи?", "o": ["Использование большого словарного запаса", "Употребление множества терминов", "Долгие разговоры", "Громкий голос"], "e": "Избегать повторов, использовать разнообразные выражения."}, {"s": "Какое выражение соответствует норме речи?", "o": ["evə qayıtdı", "aşağı endi", "yuxarı qalxdı", "geriyə qayıtdı"], "e": "В остальных есть лишнее слово."}, {"s": "Что не употребляется в официально-деловом стиле?", "o": ["Официальные формы обращения", "Точные даты и цифры", "Эмоциональные выражения", "Шаблонные выражения"], "e": "Язык документов нейтрален."}, {"s": "Что делает заключительная часть текста?", "o": ["Подводит итог и обобщает", "Приводит доказательства", "Задаёт вопрос", "Представляет тему"], "e": "Заключение завершает текст."}, {"s": "В каком случае нарушается признак «связность» текста?", "o": ["Когда между предложениями нет логической связи", "Когда текст длинный", "Когда много абзацев", "Когда нет заголовка"], "e": "Несвязанные предложения не образуют текст."}, {"s": "Что такое тавтология?", "o": ["Устаревшее слово", "Употребление лишнего слова", "Повтор слов с одним корнем", "Новое слово"], "e": "В случаях вроде «Yazıçı yazı yazdı» повторяется один и тот же корень."}]}, "Mətn və nitq mədəniyyəti — 3-ci toplu": "Культура текста и речи — Сборник 3"}