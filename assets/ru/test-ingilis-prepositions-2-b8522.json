{"__q": {"t": "Предлоги и фразовые глаголы — Сборник 2", "q": [{"s": "Complete: «Look ___ this picture.»", "o": ["to", "in", "on", "at"], "e": "«Look at» — смотреть."}, {"s": "Complete: «He looks ___ his father.»", "o": ["after", "at", "for", "like"], "e": "«Look like» — быть похожим."}, {"s": "Complete: «She looks ___ her sister's children.»", "o": ["for", "at", "after", "like"], "e": "«Look after» — заботиться."}, {"s": "Complete: «I'm looking ___ my keys.»", "o": ["for", "at", "after", "like"], "e": "«Look for» — искать."}, {"s": "Complete: «The plane took ___ on time.»", "o": ["in", "on", "up", "off"], "e": "«Take off» — взлетать."}, {"s": "Complete: «Please give ___ smoking.»", "o": ["off", "up", "in", "out"], "e": "«Give up» — бросать."}, {"s": "Complete: «We ran ___ of petrol.»", "o": ["in", "off", "out", "up"], "e": "«Run out of» — истощиться, закончиться."}, {"s": "Complete: «Turn ___ the light, please.»", "o": ["at", "in", "to", "on"], "e": "«Turn on» — включать."}, {"s": "Complete: «He put ___ the meeting until Friday.»", "o": ["up", "off", "on", "in"], "e": "«Put off» — откладывать."}, {"s": "Complete: «She gets ___ well with everyone.»", "o": ["in", "up", "on", "off"], "e": "«Get on with» — ладить."}]}, "Prepositions and Phrasal Verbs — 2-ci toplu": "Предлоги и фразовые глаголы — Сборник 2"}