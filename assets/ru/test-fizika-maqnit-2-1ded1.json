{"__q": {"t": "Магнитное поле — Сборник 2", "q": [{"s": "Как сила Лоренца изменяет траекторию заряда?", "o": ["Сохраняет прямой", "Заставляет двигаться по окружности", "Останавливает", "Ускоряет"], "e": "Не изменяет значение скорости."}, {"s": "Совершает ли сила Лоренца работу?", "o": ["Иногда", "Да", "Всегда", "Нет — она перпендикулярна скорости"], "e": "Кинетическая энергия не изменяется."}, {"s": "От чего защищает магнитное поле Земли?", "o": ["От тепла", "От заряженных частиц солнечного ветра", "От холода", "От звука"], "e": "Называется магнитосферой."}, {"s": "С чем связано полярное сияние?", "o": ["С преломлением света", "С теплом", "С электролизом", "Со взаимодействием заряженных частиц с атмосферой"], "e": "Наблюдается вблизи магнитных полюсов."}, {"s": "Что является примером ферромагнетиков?", "o": ["Алюминий", "Медь", "Стекло", "Железо, никель, кобальт"], "e": "Сильно намагничиваются."}, {"s": "Как работает компас?", "o": ["От электричества", "От притяжения", "Магнитное поле Земли ориентирует стрелку", "От света"], "e": "Это магнитная стрелка."}, {"s": "На каком принципе основан электродвигатель?", "o": ["Джоуля — Ленца", "Индукции", "Действие магнитного поля на рамку с током", "Кулона"], "e": "Возникает вращающий момент."}, {"s": "Как вычисляется магнитный поток?", "o": ["Φ = B/S", "Φ = BS·cosα", "Φ = S/B", "Φ = BSsin"], "e": "Измеряется в веберах."}, {"s": "Какова единица магнитного потока?", "o": ["Тесла", "Ом", "Вебер", "Генри"], "e": "1 Вб = 1 Тл·м²."}, {"s": "Каково свойство диамагнетиков?", "o": ["Сильно притягиваются", "Проводят ток", "Совсем не намагничиваются", "Слабо отталкиваются от магнитного поля"], "e": "Примеры — медь, вода."}]}, "Maqnit sahəsi — 2-ci toplu": "Магнитное поле — Сборник 2"}