{"__q": {"t": "Промышленная революция — Сборник 3", "q": [{"s": "Каково экологическое последствие промышленной революции?", "o": ["Не повлияла", "Рост загрязнения воздуха и воды", "Облесение", "Восстановление природы"], "e": "Использование угля было высоким."}, {"s": "Какая страна в конце XIX века соперничала с США в промышленности?", "o": ["Германия", "Россия", "Испания", "Османская империя"], "e": "Быстрая индустриализация."}, {"s": "Каково экономическое значение железной дороги?", "o": ["Не повлияла", "Удорожание", "Объединение внутреннего рынка и ускорение торговли", "Препятствие"], "e": "Перевозка сырья и продукции."}, {"s": "В каком году открыт Суэцкий канал?", "o": ["1914", "1769", "1869", "1956"], "e": "Сократил морской путь."}, {"s": "Какое изобретение изменило сельское хозяйство?", "o": ["Телефон", "Телеграф", "Трактор и комбайн", "Радио"], "e": "Механизация повысила производительность."}, {"s": "Как промышленная революция повлияла на структуру семьи?", "o": ["Не повлияла", "Укрепилась большая семья", "Вовлечение женщин и детей в производство", "Никаких изменений"], "e": "Возникли социальные проблемы."}, {"s": "Какая отрасль называется «тяжёлой промышленностью»?", "o": ["Швейная", "Пищевая", "Текстильная", "Металлургия, машиностроение, добыча полезных ископаемых"], "e": "Производит средства производства."}, {"s": "Что означает вывоз капитала?", "o": ["Налог", "Направление капитала в другие страны", "Импорт", "Продажа товаров"], "e": "Один из признаков империализма."}, {"s": "Какой фактор сделал возможной промышленную революцию в Англии?", "o": ["Случайность", "Только климат", "Изоляция", "Накопление капитала, запасы угля и железа, колонии и рынок труда"], "e": "Сошлись многие факторы."}, {"s": "Какой тип общества приходит после индустриального?", "o": ["Постиндустриальное (информационное) общество", "Рабовладельческое", "Аграрное", "Феодальное"], "e": "Преобладают услуги и знания."}]}, "Sənaye inqilabı — 3-ci toplu": "Промышленная революция — Сборник 3"}