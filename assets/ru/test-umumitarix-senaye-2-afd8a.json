{"__q": {"t": "Промышленная революция — Сборник 2", "q": [{"s": "Кто изобрёл телефон?", "o": ["Морзе", "Маркони", "Александр Белл", "Эдисон"], "e": "1876 год."}, {"s": "Кто сделал электрическую лампочку массовой?", "o": ["Уатт", "Тесла", "Томас Эдисон", "Белл"], "e": "Революция в освещении."}, {"s": "Кто считается создателем радиосвязи?", "o": ["Эдисон", "Белл", "Морзе", "Маркони (и Попов)"], "e": "Беспроводная связь."}, {"s": "Кто организовал массовое производство автомобилей?", "o": ["Дизель", "Даймлер", "Бенц", "Генри Форд"], "e": "Внедрил конвейерную систему."}, {"s": "В чём значение конвейерной системы?", "o": ["Не влияет", "Потеря качества", "Удорожание", "Рост производительности и снижение цены"], "e": "Эпоха массового производства."}, {"s": "Что такое монополия?", "o": ["Свободная конкуренция", "Цех", "Крупное объединение, единолично господствующее на рынке", "Малое предприятие"], "e": "Формы: трест, синдикат, картель."}, {"s": "Что означает империализм?", "o": ["Феодализм", "Демократия", "Изоляция", "Стадия колониальной экспансии крупного капитала"], "e": "Конец XIX века."}, {"s": "На какой период приходится раздел Африки?", "o": ["XV век", "XVI век", "Середина XX века", "Конец XIX века"], "e": "Урегулирован Берлинской конференцией."}, {"s": "На какой идее основан марксизм?", "o": ["Национализм", "Либерализм", "Классовая борьба и устранение капитализма", "Абсолютизм"], "e": "Труд «Капитал»."}, {"s": "С чем связано возникновение социального законодательства?", "o": ["Церковь", "Давление рабочего движения", "Воля короля", "Случайность"], "e": "Рабочий день, страхование, ограничение детского труда."}]}, "Sənaye inqilabı — 2-ci toplu": "Промышленная революция — Сборник 2"}