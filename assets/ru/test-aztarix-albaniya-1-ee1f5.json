{"__q": {"t": "Кавказская Албания — Сборник 1", "q": [{"s": "В каком веке пало государство Албания?", "o": ["V век", "X век", "VIII век", "XII век"], "e": "Утратило независимость в период Арабского халифата."}, {"s": "Кто самый известный правитель династии Мехранидов?", "o": ["Вачаган", "Урнайр", "Вараз-Трдат", "Джаваншир"], "e": "В VII веке боролся против внешнего давления."}, {"s": "Чем известен Урнайр?", "o": ["Принял христианство", "Выиграл войну", "Создал алфавит", "Основал город"], "e": "Официально утвердил христианство в Албании."}, {"s": "Какая отрасль хозяйства была основной в Албании?", "o": ["Горное дело", "Ткачество", "Земледелие, виноградарство, скотоводство", "Мореплавание"], "e": "Кура-Араксинская низменность была плодородной."}, {"s": "Вассалом какого государства была Албания (V–VI века)?", "o": ["Византии", "Рима", "Сасанидского Ирана", "Арабского халифата"], "e": "Влияние Сасанидов было сильным."}, {"s": "Где находился центр албанской церкви?", "o": ["Габала", "Барда", "Гянджа", "Шамахы"], "e": "Барда был религиозным и политическим центром."}, {"s": "Какая система письма использовалась в Кавказской Албании?", "o": ["Арабская", "Албанский алфавит", "Латинская", "Греческая"], "e": "Самобытный алфавит из 52 букв."}, {"s": "Кто такой марзбан в Албании?", "o": ["Полководец", "Купец", "Священнослужитель", "Наместник, назначаемый Сасанидами"], "e": "Был административным правителем."}, {"s": "Какой известный храмовый комплекс находится на территории Албании?", "o": ["Девичья башня", "Кумская базилика", "Дворец Ширваншахов", "Момине-хатун"], "e": "Образец раннехристианской архитектуры."}, {"s": "На каких языках в основном говорило население Албании?", "o": ["Только на арабском", "Только на персидском", "На греческом", "На кавказских и тюркских языках"], "e": "Население было многоязычным."}]}, "Qafqaz Albaniyası — 1-ci toplu": "Кавказская Албания — Сборник 1"}