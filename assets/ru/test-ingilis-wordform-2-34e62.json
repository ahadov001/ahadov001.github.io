{"__q": {"t": "Word Formation — Сборник 2", "q": [{"s": "Form a noun from «able».", "o": ["ableness", "abling", "ability", "abled"], "e": "Образование не по правилам."}, {"s": "Form an adjective from «danger».", "o": ["dangerful", "dangerous", "dangerly", "dangered"], "e": "Суффикс «-ous»."}, {"s": "Form a noun from «arrive».", "o": ["arrival", "arrivance", "arrivement", "arriving only"], "e": "Суффикс «-al»."}, {"s": "What does «-less» mean?", "o": ["full of", "before", "without", "again"], "e": "Homeless — бездомный."}, {"s": "Form an adjective from «nation».", "o": ["nationful", "national", "nationly", "nationous"], "e": "«-al» образует прилагательное."}, {"s": "Form a verb from «simple».", "o": ["simplen", "simply", "simplify", "simpleize"], "e": "«-ify» образует глагол."}, {"s": "What does the prefix «over-» mean?", "o": ["under", "not enough", "again", "too much"], "e": "Overwork — работать сверх меры."}, {"s": "Form a noun from «free».", "o": ["freeing", "freeness", "freedom", "freely"], "e": "«-dom» образует абстрактное существительное."}, {"s": "Form an adjective from «hope».", "o": ["hopeful", "hoping only", "hoped", "hopely"], "e": "Суффикс «-ful»."}, {"s": "What does the prefix «pre-» mean?", "o": ["not", "after", "again", "before"], "e": "Preview — предварительный просмотр."}]}, "Word Formation — 2-ci toplu": "Word Formation — Сборник 2"}