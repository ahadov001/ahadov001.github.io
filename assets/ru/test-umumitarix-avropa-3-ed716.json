{"__q": {"t": "Европа в Средние века — Сборник 3", "q": [{"s": "Между кем шла война Алой и Белой розы в Англии?", "o": ["Между династиями Ланкастеров и Йорков", "Между королём и церковью", "Между Англией и Францией", "Между городом и деревней"], "e": "Завершилась воцарением династии Тюдоров."}, {"s": "В какой войне участвовала Жанна д’Арк?", "o": ["В Тридцатилетней", "В Столетней войне", "В Пунической", "В крестовом походе"], "e": "Национальная героиня Франции."}, {"s": "Какая династия правила в России с 1613 года?", "o": ["Рюриковичи", "Романовы", "Габсбурги", "Бурбоны"], "e": "До 1917 года."}, {"s": "Какими странами правили Габсбурги?", "o": ["Австрией, Испанией и обширными европейскими землями", "Только Испанией", "Османской империей", "Россией"], "e": "Расширялись благодаря брачной политике."}, {"s": "Как называлось самоуправление средневековых городов?", "o": ["Ном", "Сатрапия", "Полис", "Коммуна"], "e": "Добились независимости от феодала."}, {"s": "Чем характерна готическая архитектура?", "o": ["Пирамида", "Колонны", "Высокие своды, острые башни, витражи", "Купол"], "e": "Пример — собор Нотр-Дам."}, {"s": "Чем характерен романский стиль?", "o": ["Острые башни", "Только купол", "Толстые стены, полукруглые арки", "Витраж"], "e": "Стиль, предшествовавший готике."}, {"s": "Как развитие товарно-денежных отношений повлияло на феодализм?", "o": ["Усилило крепостное право", "Не оказало влияния", "Укрепило", "Ослабило и открыло путь капитализму"], "e": "Переход к рыночной экономике."}, {"s": "Что такое мануфактура?", "o": ["Крупная мастерская, основанная на ручном труде, с разделением труда", "Фабрика", "Цех", "Ферма"], "e": "Этап, предшествовавший фабрике."}, {"s": "Какое событие считается концом Средневековья?", "o": ["Падение Константинополя и Великие географические открытия", "1914 год", "476 год", "1789 год"], "e": "Начинается Новое время."}]}, "Orta əsrlərdə Avropa — 3-ci toplu": "Европа в Средние века — Сборник 3"}