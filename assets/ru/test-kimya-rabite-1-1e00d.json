{"__q": {"t": "Химическая связь — Сборник 1", "q": [{"s": "Как образуется ковалентная связь?", "o": ["Случайно", "Общей электронной парой", "Слиянием ядер", "Передачей электронов"], "e": "Между атомами неметаллов."}, {"s": "Как образуется ионная связь?", "o": ["Полной передачей электрона", "Водородная связь", "Общий электрон", "Металлическая связь"], "e": "Между металлом и неметаллом."}, {"s": "Какая связь в NaCl?", "o": ["Водородная", "Металлическая", "Ионная", "Ковалентная неполярная"], "e": "Na отдаёт электрон, Cl принимает."}, {"s": "Какая связь в молекуле H₂?", "o": ["Металлическая", "Ковалентная полярная", "Ионная", "Ковалентная неполярная"], "e": "Между одинаковыми атомами."}, {"s": "Какая связь в HCl?", "o": ["Ионная", "Водородная", "Ковалентная полярная", "Металлическая"], "e": "Электроотрицательности различны."}, {"s": "Что такое металлическая связь?", "o": ["Ионное притяжение", "Электронная пара", "Связь между положительными ионами и свободными электронами", "Водородный мостик"], "e": "Объясняет электропроводность металлов."}, {"s": "Где наблюдается водородная связь?", "o": ["NaCl", "Между молекулами воды", "В алмазе", "В железе"], "e": "Причина высокой температуры кипения воды."}, {"s": "Каково свойство ионных соединений?", "o": ["Не растворяются", "Высокая температура плавления, проводят ток в растворе", "В газообразном состоянии", "Низкая температура плавления"], "e": "Кристаллическая решётка прочная."}, {"s": "От чего зависит полярность ковалентной связи?", "o": ["От разности электроотрицательностей", "От цвета", "От объёма", "От массы"], "e": "Если разность велика, связь полярная."}, {"s": "Какая связь в алмазе?", "o": ["Ковалентная", "Водородная", "Металлическая", "Ионная"], "e": "Атомная кристаллическая решётка."}]}, "Kimyəvi rabitə — 1-ci toplu": "Химическая связь — Сборник 1"}