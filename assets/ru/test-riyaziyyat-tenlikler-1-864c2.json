{"__q": {"t": "Уравнения — Сборник 1", "q": [{"s": "Чему равен корень уравнения 2x + 6 = 0?", "o": ["−3", "6", "3", "−6"], "e": "2x = −6 → x = −3."}, {"s": "Сколько корней имеет уравнение x² = 25?", "o": ["1", "Бесконечность", "2", "0"], "e": "x = 5 и x = −5."}, {"s": "Каковы корни уравнения x² − 5x + 6 = 0?", "o": ["2 и 3", "1 и 6", "−2 и −3", "5 и 6"], "e": "Теорема Виета: сумма 5, произведение 6."}, {"s": "По какой формуле вычисляется дискриминант квадратного уравнения?", "o": ["−b/2a", "b²+4ac", "b²−4ac", "2a/b"], "e": "D = b² − 4ac."}, {"s": "Сколько действительных корней имеет квадратное уравнение при D > 0?", "o": ["0", "1", "2", "Бесконечность"], "e": "Два различных действительных корня."}, {"s": "Сколько корней при D = 0?", "o": ["2", "1 (два равных)", "Бесконечность", "0"], "e": "x = −b/2a."}, {"s": "Сколько действительных корней при D < 0?", "o": ["1", "2", "0", "Бесконечность"], "e": "На множестве действительных чисел корней нет."}, {"s": "Что выражает теорема Виета?", "o": ["Сумму и произведение корней", "Производную", "График", "Дискриминант"], "e": "x₁+x₂ = −b/a, x₁·x₂ = c/a."}, {"s": "Чему равен корень уравнения 3x = 12?", "o": ["3", "9", "4", "36"], "e": "Делим обе части на 3."}, {"s": "Чему равен корень уравнения x/2 = 5?", "o": ["10", "7", "5", "2,5"], "e": "Умножаем обе части на 2."}]}, "Tənliklər — 1-ci toplu": "Уравнения — Сборник 1"}