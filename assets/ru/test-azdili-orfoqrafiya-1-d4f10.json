{"__q": {"t": "Орфография — Сборник 1", "q": [{"s": "Какое слово написано правильно?", "o": ["mühəllim", "müəllım", "müəllim", "muəllim"], "e": "Правильная форма: müəllim."}, {"s": "Какое слово написано правильно?", "o": ["aielə", "ailə", "aylə", "ayilə"], "e": "Правильная форма: ailə."}, {"s": "Какое слово написано правильно?", "o": ["tələbə́", "tələbbə", "teləbə", "tələbə"], "e": "Правильная форма: tələbə."}, {"s": "Какое слово написано правильно?", "o": ["sahibkar", "sahibqar", "saibkar", "sahipkar"], "e": "Правильная форма: sahibkar."}, {"s": "В каком слове правильно написана двойная согласная?", "o": ["hıs", "hizz", "his", "hiss"], "e": "Слово «hiss» пишется с двойным «s»."}, {"s": "Как пишутся имена собственные?", "o": ["Через дефис", "С маленькой буквы", "В кавычках", "С большой буквы"], "e": "Имена людей, названия мест и произведений пишутся с большой буквы."}, {"s": "Какое слово написано правильно?", "o": ["məsala", "mesələ", "məsəllə", "məsələ"], "e": "Правильная форма: məsələ."}, {"s": "Как указываются порядковые числительные при записи цифрами?", "o": ["5'ci", "5ci", "5 ci", "5-ci"], "e": "Суффикс присоединяется через дефис: 5-ci, 10-cu."}, {"s": "Какое слово написано правильно?", "o": ["əlbətte", "əlbətdə", "əlbəttə", "albəttə"], "e": "Правильная форма: əlbəttə — с двойным «t»."}, {"s": "Какое слово написано правильно?", "o": ["ixdisas", "ixtisas", "ihtisas", "ictisas"], "e": "Правильная форма: ixtisas."}, {"s": "В каком ряду слова написаны правильно?", "o": ["qaydə, layihə, məsuliyyət", "qaydə, layıhə, məsulyyət", "qayda, layıhə, məsuliyət", "qayda, layihə, məsuliyyət"], "e": "Правильные формы: qayda, layihə, məsuliyyət."}, {"s": "Какое слово написано правильно?", "o": ["mutəxəssis", "mütaxəssis", "mütəxəsis", "mütəxəssis"], "e": "Правильная форма: mütəxəssis — с двойным «s»."}, {"s": "Как могут писаться сложные слова?", "o": ["Только раздельно", "Только слитно", "Только через дефис", "Слитно или через дефис"], "e": "Одни сложные слова пишутся слитно (günəbaxan), другие через дефис (bir-bir)."}, {"s": "Какое слово написано правильно?", "o": ["iştirrak", "işdirak", "iştirak", "iştırak"], "e": "Правильная форма: iştirak."}, {"s": "Какое слово написано правильно?", "o": ["fəaliyət", "fəalyyət", "fəaliyyət", "faaliyyət"], "e": "Правильная форма: fəaliyyət."}, {"s": "Что ставится между парными словами?", "o": ["Дефис", "Точка", "Запятая", "Ничего"], "e": "«Bir-bir», «tez-tez», «ağ-qara» — пишутся через дефис."}, {"s": "Какое слово написано правильно?", "o": ["təşəkür", "teşəkkür", "təşəkkür", "təşakkür"], "e": "Правильная форма: təşəkkür — с двойным «k»."}, {"s": "Какое слово написано правильно?", "o": ["cəmmiyyət", "cəmiyət", "camiyyət", "cəmiyyət"], "e": "Правильная форма: cəmiyyət."}]}, "Orfoqrafiya — 1-ci toplu": "Орфография — Сборник 1"}