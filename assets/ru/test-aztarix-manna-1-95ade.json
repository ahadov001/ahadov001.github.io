{"__q": {"t": "Манна, Мидия, Атропатена — Сборник 1", "q": [{"s": "Вокруг какого озера возникло государство Манна?", "o": ["Ван", "Урмия", "Гёйча (Севан)", "Каспий"], "e": "На территории Южного Азербайджана."}, {"s": "С какими государствами боролась Манна?", "o": ["Китай", "Рим и Египет", "Ассирия и Урарту", "Греция"], "e": "Существовало соперничество с сильными соседями."}, {"s": "Каким государством была подчинена Манна?", "o": ["Рим", "Ассирия", "Мидия", "Византия"], "e": "В конце VII века до н.э. была включена в состав Мидии."}, {"s": "Какой город был столицей Мидии?", "o": ["Экбатаны", "Изирту", "Газака", "Персеполь"], "e": "Экбатаны (современный Хамадан)."}, {"s": "В каком году Мидия была разгромлена Ахеменидами?", "o": ["612 до н.э.", "224 н.э.", "550 до н.э.", "330 до н.э."], "e": "Киром II."}, {"s": "Когда возникла Атропатена?", "o": ["VI век до н.э.", "III век н.э.", "IX век до н.э.", "Конец IV века до н.э."], "e": "После распада империи Александра."}, {"s": "Кто такой Атропат?", "o": ["Албанский царь", "Римский император", "Греческий полководец", "Сатрап Мидии"], "e": "Объявил независимость и основал государство."}, {"s": "С какой империей боролась Атропатена?", "o": ["Индия", "Китай", "Египет", "Рим"], "e": "Находилась между Римом и Парфией."}, {"s": "Какая отрасль хозяйства была ведущей в Манне?", "o": ["Мореплавание", "Земледелие и коневодство", "Торговля", "Горное дело"], "e": "Маннейские кони были знамениты в Ассирии."}, {"s": "В состав какого государства была включена Атропатена (III век)?", "o": ["Арабского халифата", "Сасанидского Ирана", "Византии", "Рима"], "e": "Была подчинена Сасанидами."}]}, "Manna, Midiya, Atropatena — 1-ci toplu": "Манна, Мидия, Атропатена — Сборник 1"}