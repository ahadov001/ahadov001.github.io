{"__q": {"t": "Теория литературы — Сборник 2", "q": [{"s": "Что учитывается в слоговом размере?", "o": ["Количество слогов", "Долгие и краткие слоги", "Ударение", "Рифма"], "e": "Народная поэзия написана слоговым размером."}, {"s": "Что является основой размера аруз?", "o": ["Количество слов", "Количество слогов", "Долгота и краткость слогов", "Ударение"], "e": "Это размер классической восточной поэзии."}, {"s": "Чего нет в свободном стихе?", "o": ["Устойчивого размера и рифмы", "Образа", "Ритма", "Мысли"], "e": "Ритм есть, но устойчивого размера нет."}, {"s": "Что такое сюжет?", "o": ["Идея произведения", "Образы", "Язык", "Последовательность событий"], "e": "Это расположение событий в произведении."}, {"s": "Что такое композиция?", "o": ["Язык", "Тема", "Строение и расположение частей произведения", "Сюжет"], "e": "Это архитектоника произведения."}, {"s": "Что такое конфликт?", "o": ["Образ", "Столкновение, противоречие", "Языковое средство", "Жанр"], "e": "Это движущая сила сюжета."}, {"s": "Что такое идея произведения?", "o": ["Язык", "Основная мысль, которую автор хочет донести", "Событие", "Образ"], "e": "В отличие от темы, идея — это позиция автора."}, {"s": "Что такое тема?", "o": ["Жизненный материал, изображённый в произведении", "Язык", "Основная мысль", "Жанр"], "e": "Это то, о чём написано произведение."}, {"s": "Что такое антитеза (тазад)?", "o": ["Преувеличение", "Сравнение", "Повтор", "Противопоставление противоположных понятий"], "e": "Мысль усиливается через противоречие."}, {"s": "Что такое повтор (такрир)?", "o": ["Сравнение", "Антитеза", "Преувеличение", "Повторение слова или выражения"], "e": "Повторяется для усиления воздействия."}]}, "Ədəbiyyat nəzəriyyəsi — 2-ci toplu": "Теория литературы — Сборник 2"}