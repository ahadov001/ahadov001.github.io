{"__q": {"t": "Орфография — Сборник 3", "q": [{"s": "Какое написание правильное?", "o": ["xosbəxt", "xoşbext", "xoşbəxt", "xoşbəht"], "e": "Пишется с «x»: xoşbəxt."}, {"s": "Какие слова пишутся с большой буквы в названиях государств и организаций?", "o": ["Только первое слово", "Последнее слово", "Каждое слово", "Никакие"], "e": "Azərbaycan Respublikası, Milli Məclis."}, {"s": "В каком слове не пишется двойная согласная?", "o": ["ssenari", "immunitet", "kolektiv", "professor"], "e": "Правильно «kollektiv» — с двойным «ll»."}, {"s": "Почему в слове «Vitse-prezident» есть дефис?", "o": ["Это повтор", "Приставка «Vitse-» пишется через дефис", "Это два существительных", "Это ошибка"], "e": "Эта приставка всегда соединяется через дефис."}, {"s": "Как пишется название газеты?", "o": ["Через дефис", "С большой буквы, без знаков", "В кавычках", "В скобках"], "e": "«Azərbaycan» qəzeti."}, {"s": "Какое выражение пишется слитно?", "o": ["ikiotaqlı", "sənin üçün", "kitab kimi", "əmr vermək"], "e": "Сложное слово «числительное + существительное» пишется слитно."}, {"s": "Почему «Bir-bir» пишется через дефис?", "o": ["Это числительное", "Это слова противоположного значения", "Это повтор одного и того же слова", "Это сложное слово"], "e": "Повторяющиеся слова пишутся через дефис."}, {"s": "В каком слове написание неверно?", "o": ["laqeyd", "mütləq", "sabik", "ailə"], "e": "Правильно «sabiq» — с «q»."}, {"s": "Как пишутся клички животных?", "o": ["В кавычках", "С маленькой буквы", "С большой буквы", "Через дефис"], "e": "Alabaş, Qaşqa — пишутся с большой буквы как имена собственные."}, {"s": "Чем объясняется написание сочетания «Qab-qacaq»?", "o": ["Слова противоположного значения", "Это числительное", "Одно из слов — бессмысленный повтор", "Слова близкого значения"], "e": "«Qacaq» самостоятельного значения не имеет."}, {"s": "На скольких принципах основана азербайджанская орфография?", "o": ["5", "3", "4", "2"], "e": "Фонетический, морфологический, историко-традиционный, дифференцирующий."}, {"s": "В каком ряду все слова написаны правильно?", "o": ["müəllim, təşəkür, əlbəttə", "müəlim, təşəkkür, əlbətdə", "müəllim, təşəkkür, əlbəttə", "müəlim, təşəkür, əlbətdə"], "e": "Все три написаны правильно с двойными согласными."}]}, "Orfoqrafiya — 3-ci toplu": "Орфография — Сборник 3"}