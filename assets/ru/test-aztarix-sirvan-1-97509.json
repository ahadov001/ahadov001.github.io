{"__q": {"t": "Государства IX–XII веков — Сборник 1", "q": [{"s": "Когда возникло государство Ширваншахов?", "o": ["XII век", "XV век", "VI век", "IX век"], "e": "Начало положила династия Мазъядидов в 861 году."}, {"s": "Какой город был столицей государства Ширваншахов?", "o": ["Гянджа", "Баку", "Дербент", "Шамахы"], "e": "Позднее столица была перенесена в Баку."}, {"s": "В каком городе находится Дворец Ширваншахов?", "o": ["Гянджа", "Баку", "Шеки", "Шамахы"], "e": "Расположен в Ичеришехер, является наследием ЮНЕСКО."}, {"s": "Когда существовало государство Саджидов?", "o": ["XII век", "XV век", "IX–X века", "VII век"], "e": "Возникло в Южном Азербайджане."}, {"s": "Кто основал государство Атабеков?", "o": ["Джаваншир", "Шамседдин Эльдениз", "Узун Гасан", "Шах Исмаил"], "e": "Называется династией Эльденизидов."}, {"s": "Какой город был столицей государства Атабеков?", "o": ["Нахчыван и Тебриз", "Баку", "Шамахы", "Барда"], "e": "Центр менялся, в основном Тебриз."}, {"s": "При каком государстве жил Низами Гянджеви?", "o": ["Атабеки", "Сефевиды", "Гарагоюнлу", "Ширваншахи"], "e": "XII век — период Атабеков."}, {"s": "Где находится мавзолей Мумине хатун?", "o": ["Нахчыван", "Шеки", "Баку", "Гянджа"], "e": "Построен архитектором Аджеми Нахчывани."}, {"s": "Что развивалось в Азербайджане в IX–XII веках?", "o": ["Только война", "Изоляция", "Городская культура, наука и архитектура", "Кочевничество"], "e": "Считается периодом Ренессанса."}, {"s": "Сколько веков (приблизительно) существовало государство Ширваншахов?", "o": ["Более 6", "4", "2", "1"], "e": "С IX по XVI век."}]}, "IX–XII əsr dövlətləri — 1-ci toplu": "Государства IX–XII веков — Сборник 1"}