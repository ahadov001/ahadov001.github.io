{"__q": {"t": "Клетка — Сборник 1", "q": [{"s": "Кто выдвинул клеточную теорию?", "o": ["Мендель", "Шлейден и Шванн", "Пастер", "Дарвин"], "e": "Сформулирована в 1838–1839 годах."}, {"s": "Какой органоид является энергетическим центром клетки?", "o": ["Митохондрия", "Ядро", "Рибосома", "Аппарат Гольджи"], "e": "Здесь происходит синтез АТФ."}, {"s": "В каком органоиде происходит синтез белка?", "o": ["Вакуоль", "Митохондрия", "Лизосома", "Рибосома"], "e": "Рибосомы — «фабрика» белка."}, {"s": "Что есть в растительной клетке, но отсутствует в животной?", "o": ["Митохондрия", "Хлоропласт и клеточная стенка", "Рибосома", "Ядро"], "e": "Целлюлозная стенка и органоид фотосинтеза."}, {"s": "Где хранится наследственная информация клетки?", "o": ["Цитоплазма", "Ядро (в ДНК)", "Митохондрия", "Мембрана"], "e": "Хромосомы находятся в ядре."}, {"s": "Какова функция лизосомы?", "o": ["Движение", "Внутриклеточное пищеварение", "Синтез белка", "Энергия"], "e": "Расщепляет вещества с помощью ферментов."}, {"s": "Чего нет в прокариотической клетке?", "o": ["Мембраны", "Цитоплазмы", "Оформленного ядра", "Рибосом"], "e": "У бактерий нет ядерной оболочки."}, {"s": "Какова основная функция клеточной мембраны?", "o": ["Наследственность", "Синтез белка", "Выработка энергии", "Избирательная проницаемость для веществ"], "e": "Обладает полупроницаемостью."}, {"s": "Какова функция аппарата Гольджи?", "o": ["Движение", "Энергия", "Накопление, упаковка и транспортировка веществ", "Наследственность"], "e": "Занимается секрецией."}, {"s": "Какова роль большой вакуоли в растительной клетке?", "o": ["Деление", "Синтез белка", "Фотосинтез", "Хранение клеточного сока и создание тургора"], "e": "Помогает клетке сохранять форму."}]}, "Hüceyrə — 1-ci toplu": "Клетка — Сборник 1"}