{"__q": {"t": "Государства IX–XII веков — Сборник 2", "q": [{"s": "В каком городе находится Девичья башня?", "o": ["Шамахы", "Баку", "Шеки", "Гянджа"], "e": "Символ Ичеришехер."}, {"s": "Где возникло государство Саларидов?", "o": ["Ширван", "Нахчыван", "Южный Азербайджан", "Карабах"], "e": "В X веке в окрестностях Тебриза."}, {"s": "Какой город был центром государства Шеддадидов?", "o": ["Тебриз", "Шамахы", "Гянджа", "Баку"], "e": "Гянджа была столицей Шеддадидов."}, {"s": "Где сейчас находятся Гянджинские ворота?", "o": ["Грузия (Гелати)", "Иран", "Баку", "Турция"], "e": "Охраняются как исторический памятник."}, {"s": "Какие научные центры действовали в Азербайджане в XII веке?", "o": ["Отсутствовали", "Университеты", "Академии", "Медресе и обсерватории"], "e": "Научная среда была сильной."}, {"s": "При каком дворе жил Хагани Ширвани?", "o": ["Ширваншахов", "Сефевидов", "Атабеков", "Османском"], "e": "Был поэтом при дворе Ширваншахов."}, {"s": "В результате какого нашествия государство Атабеков ослабло?", "o": ["Римского", "Монгольского", "Османского", "Русского"], "e": "Монгольские походы XIII века."}, {"s": "Какие династии правили в государстве Ширваншахов?", "o": ["Сефевиды", "Только одна", "Каджары", "Мазъядиды, Касраниды, Дербендиды"], "e": "Различные династии сменяли друг друга."}, {"s": "В какую эпоху правил Ибрагим I Ширваншах?", "o": ["XVI век", "XIV–XV века", "XII век", "X век"], "e": "Умело вёл политику в период походов Тамерлана."}, {"s": "Кто положил конец государству Ширваншахов?", "o": ["Тамерлан", "Шах Тахмасиб I", "Узун Гасан", "Надир-шах"], "e": "В XVI веке было включено в состав Сефевидов."}]}, "IX–XII əsr dövlətləri — 2-ci toplu": "Государства IX–XII веков — Сборник 2"}