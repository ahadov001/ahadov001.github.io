{"__q": {"t": "Клетка — Сборник 2", "q": [{"s": "Что находится на гранулярной разновидности эндоплазматической сети?", "o": ["Лизосомы", "Вакуоли", "Хлоропласты", "Рибосомы"], "e": "Рибосомы прикреплены к её поверхности."}, {"s": "Какой пигмент содержится в хлоропласте?", "o": ["Гемоглобин", "Меланин", "Хлорофилл", "Только каротин"], "e": "Придаёт зелёный цвет и поглощает свет."}, {"s": "В каком процессе участвует клеточный центр (центриоль)?", "o": ["Дыхание", "Пищеварение", "Фотосинтез", "Деление клетки"], "e": "Формирует нити веретена деления."}, {"s": "Какой пример эукариотической клетки?", "o": ["Вирус", "Растительная клетка", "Сине-зелёная водоросль", "Бактерия"], "e": "Имеет оформленное ядро."}, {"s": "Что такое АТФ?", "o": ["Гормон", "Фермент", "Универсальный переносчик энергии", "Белок"], "e": "Аденозинтрифосфорная кислота."}, {"s": "Что такое осмос?", "o": ["Прохождение воды через полупроницаемую мембрану", "Синтез белка", "Выработка энергии", "Деление"], "e": "Происходит из-за разницы концентраций."}, {"s": "Из чего состоит клеточная стенка (у растений)?", "o": ["Хитин", "Целлюлоза", "Жир", "Белок"], "e": "У грибов же она состоит из хитина."}, {"s": "Что такое ферменты?", "o": ["Биологические катализаторы (белки)", "Витамины", "Жиры", "Гормоны"], "e": "Ускоряют скорость реакций."}, {"s": "Как называется внутренняя среда клетки?", "o": ["Цитоплазма", "Вакуоль", "Мембрана", "Ядро"], "e": "Здесь расположены органоиды."}, {"s": "Имеет ли вирус клеточное строение?", "o": ["Только некоторые", "Да", "Неизвестно", "Нет, это неклеточная форма жизни"], "e": "Размножается только в живой клетке."}]}, "Hüceyrə — 2-ci toplu": "Клетка — Сборник 2"}