{"__q": {"t": "Неравенства — Сборник 1", "q": [{"s": "Каково решение неравенства x + 3 > 7?", "o": ["x > 10", "x < 10", "x > 4", "x < 4"], "e": "Из обеих частей вычитается 3."}, {"s": "Каково решение неравенства −2x > 6?", "o": ["x > 3", "x < 3", "x > −3", "x < −3"], "e": "При делении на отрицательное число знак меняется."}, {"s": "Что происходит при умножении обеих частей неравенства на отрицательное число?", "o": ["Не изменяется", "Знак меняется на противоположный", "Части меняются местами", "Решений нет"], "e": "Это основное правило."}, {"s": "Каково решение неравенства 2x ≤ 10?", "o": ["x ≥ 5", "x ≤ 5", "x > 5", "x < 5"], "e": "При делении на положительное число знак не меняется."}, {"s": "Каково решение неравенства x² > 0?", "o": ["x < 0", "x ≠ 0", "Все x", "x > 0"], "e": "Только при x=0 неравенство не выполняется."}, {"s": "Каково решение неравенства x² < 4?", "o": ["x < 2", "x > 2", "x > −2", "−2 < x < 2"], "e": "В виде модуля |x| < 2."}, {"s": "Что означает запись (−∞; 3)?", "o": ["x ≥ 3", "x < 3", "x > 3", "x ≤ 3"], "e": "Круглая скобка указывает открытую границу."}, {"s": "Что означает промежуток [2; 5]?", "o": ["x ≥ 5", "2 < x < 5", "x ≤ 2", "2 ≤ x ≤ 5"], "e": "Квадратная скобка указывает, что граница входит."}, {"s": "Каково решение неравенства 3x − 6 ≥ 0?", "o": ["x ≥ 2", "x ≤ 6", "x ≥ 6", "x ≤ 2"], "e": "3x ≥ 6 → x ≥ 2."}, {"s": "Каково решение неравенства |x| < 3?", "o": ["x > 3", "x < 3", "−3 < x < 3", "x > −3"], "e": "Неравенство с модулем даёт двусторонний промежуток."}]}, "Bərabərsizliklər — 1-ci toplu": "Неравенства — Сборник 1"}