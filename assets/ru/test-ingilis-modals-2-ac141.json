{"__q": {"t": "Модальные глаголы — Сборник 2", "q": [{"s": "Choose: «He can't be serious» expresses:", "o": ["ability", "obligation", "permission", "strong disbelief"], "e": "«Can't» выражает сильное недоверие."}, {"s": "Complete: «We ___ to be there at 9.»", "o": ["should to", "may", "are supposed", "must"], "e": "«Be supposed to» выражает ожидание."}, {"s": "Choose: «You needn't have worried» means:", "o": ["worrying was unnecessary", "you must worry", "you had to worry", "you can't worry"], "e": "Беспокойство было излишним."}, {"s": "Complete: «___ you help me, please?»", "o": ["Could", "May", "Should", "Must"], "e": "Вежливая просьба."}, {"s": "Choose: «She must have left» means:", "o": ["she had to leave", "she left for sure (deduction)", "she may leave", "she can leave"], "e": "Сильное предположение о прошлом."}, {"s": "Complete: «I'd rather ___ at home tonight.»", "o": ["staying", "stayed", "stay", "to stay"], "e": "«Would rather» + инфинитив без to."}, {"s": "Choose: «You had better ___ now.»", "o": ["to go", "went", "go", "going"], "e": "«Had better» + инфинитив без to."}, {"s": "Complete: «He ___ be tired; he worked all night.»", "o": ["needn't", "can't", "must", "shouldn't"], "e": "Логический вывод."}, {"s": "Choose the correct negative of «must» (prohibition).", "o": ["don't have to", "mustn't", "couldn't", "needn't"], "e": "Выражает запрет."}, {"s": "Complete: «Shall I ___ the door?»", "o": ["closed", "to close", "closing", "close"], "e": "«Shall» + инфинитив без to."}]}, "Modal Verbs — 2-ci toplu": "Модальные глаголы — Сборник 2"}