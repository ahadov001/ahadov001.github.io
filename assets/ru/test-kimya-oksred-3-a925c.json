{"__q": {"t": "Окислительно-восстановительные реакции — Сборник 3", "q": [{"s": "Какой процесс происходит на аноде?", "o": ["Нейтрализация", "Гидролиз", "Восстановление", "Окисление"], "e": "Электроны отдаются."}, {"s": "Какова степень окисления кислорода в H₂O₂?", "o": ["+2", "−1", "−2", "0"], "e": "В пероксидах она равна −1."}, {"s": "Какова степень окисления водорода в гидридах металлов?", "o": ["+2", "−1", "+1", "0"], "e": "В NaH она равна −1."}, {"s": "Какая кислота является сильным окислителем?", "o": ["H₂S", "Конц. HNO₃", "HBr", "HCl"], "e": "Растворяет также медь и серебро."}, {"s": "Как преобразуется энергия в гальваническом элементе?", "o": ["Из химической в электрическую", "Из электрической в химическую", "Не преобразуется", "Из тепла в свет"], "e": "Основа батареек."}, {"s": "Каким способом металл защищают от коррозии?", "o": ["Нагреванием", "Охлаждением", "Нанесением покрытия, протекторный металл", "Освещением"], "e": "Широко распространено цинковое покрытие (цинкование)."}, {"s": "Что такое переход Fe²⁺ → Fe³⁺?", "o": ["Окисление", "Диссоциация", "Восстановление", "Гидролиз"], "e": "Отдаётся один электрон."}, {"s": "Что такое переход Cl₂ → 2Cl⁻?", "o": ["Окисление", "Нейтрализация", "Восстановление", "Разложение"], "e": "Принимаются два электрона."}, {"s": "Какое вещество может быть как окислителем, так и восстановителем?", "o": ["H₂O₂", "He", "Na", "F₂"], "e": "Благодаря промежуточной степени окисления кислорода."}, {"s": "Для чего электролиз используется в промышленности?", "o": ["Только для исследований", "Получения алюминия, очистки металлов", "Горения", "Нагревания"], "e": "А также в производстве хлора и щёлочи."}]}, "Oksidləşmə-reduksiya — 3-ci toplu": "Окислительно-восстановительные реакции — Сборник 3"}