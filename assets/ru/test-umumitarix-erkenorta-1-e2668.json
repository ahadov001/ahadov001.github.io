{"__q": {"t": "Раннее Средневековье — Сборник 1", "q": [{"s": "Каким событием начинается Средневековье?", "o": ["Падение Западной Римской империи (476)", "Возрождение", "Основание Рима", "Крестовые походы"], "e": "Конец V века."}, {"s": "Что такое эпоха Великого переселения народов?", "o": ["Торговля", "Массовый приток кочевых народов в Европу", "Крестовый поход", "Возрождение"], "e": "Ослабила Римскую империю."}, {"s": "Кто укрепил государство франков?", "o": ["Ганнибал", "Константин", "Карл Великий", "Юстиниан"], "e": "В 800 году провозглашён императором."}, {"s": "Что такое феодализм?", "o": ["Капитализм", "Промышленный строй", "Строй, основанный на землевладении и личной зависимости", "Рабовладение"], "e": "Отношения сеньора и вассала."}, {"s": "Кто такой вассал?", "o": ["Феодал, получавший землю от сеньора и служивший ему", "Раб", "Крестьянин", "Купец"], "e": "Был обязан нести военную службу."}, {"s": "В каком веке возникла религия ислам?", "o": ["X", "IV", "VII", "XII"], "e": "На Аравийском полуострове."}, {"s": "Чем важен Арабский халифат?", "o": ["Упадок", "Небольшое государство", "Изоляция", "Обширная территория, развитие науки и культуры"], "e": "Было сильным движение переводов."}, {"s": "Какой город был столицей Византийской империи?", "o": ["Александрия", "Рим", "Афины", "Константинополь"], "e": "В 1453 году завоёван османами."}, {"s": "Кто такой Юстиниан?", "o": ["Папа римский", "Король франков", "Халиф", "Византийский император и законодатель"], "e": "Известен сводом законов."}, {"s": "Что такое натуральное хозяйство?", "o": ["Торговля", "Производство для собственных нужд", "Производство для рынка", "Промышленность"], "e": "Характерно для раннего Средневековья."}]}, "Erkən orta əsrlər — 1-ci toplu": "Раннее Средневековье — Сборник 1"}