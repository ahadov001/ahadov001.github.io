{"__q": {"t": "Период ханств — Сборник 1", "q": [{"s": "Когда возникли азербайджанские ханства?", "o": ["XIX век", "XVI век", "XVII век", "Середина XVIII века"], "e": "После смерти Надир-шаха."}, {"s": "Кто самый известный хан Губинского ханства?", "o": ["Фатали хан", "Гусейнгулу хан", "Ибрагимхалил хан", "Джавад хан"], "e": "Стремился объединить ханства."}, {"s": "Кто основатель Карабахского ханства?", "o": ["Джавад хан", "Фатали хан", "Гусейнгулу хан", "Панах Али хан"], "e": "Построил крепость Шуша."}, {"s": "Когда была основана крепость Шуша?", "o": ["1735", "1813", "1805", "1750-е годы"], "e": "Панах Али ханом."}, {"s": "Кто последний хан Гянджинского ханства?", "o": ["Ибрагимхалил хан", "Фатали хан", "Джавад хан", "Панах Али хан"], "e": "Погиб в 1804 году при обороне Гянджи."}, {"s": "В каком ханстве Молла Панах Вагиф был визирем?", "o": ["Шекинском", "Бакинском", "Губинском", "Карабахском"], "e": "Был визирем Ибрагимхалил хана."}, {"s": "Какова была главная проблема периода ханств?", "o": ["Политическая раздробленность и внутренние распри", "Язык", "Религия", "Стихийные бедствия"], "e": "Отсутствие единства создавало слабость."}, {"s": "Какова была цель Фатали хана?", "o": ["Изоляция", "Эмиграция", "Торговля", "Объединить ханства в единое государство"], "e": "Проводил политику централизации."}, {"s": "Кто основатель Шекинского ханства?", "o": ["Фатали хан", "Панах Али хан", "Гаджи Челеби", "Джавад хан"], "e": "Поднял восстание против Надир-шаха."}, {"s": "Между какими государствами оказались ханства?", "o": ["Европейскими государствами", "Китаем и Индией", "Османской империей и Египтом", "Россией и Ираном"], "e": "Были ареной соперничества двух империй."}]}, "Xanlıqlar dövrü — 1-ci toplu": "Период ханств — Сборник 1"}