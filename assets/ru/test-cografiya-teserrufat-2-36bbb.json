{"__q": {"t": "Мировое хозяйство — Сборник 2", "q": [{"s": "Что такое монокультурная экономика?", "o": ["Многоотраслевая", "Промышленная", "Экономика, зависящая от одного продукта", "Сфера услуг"], "e": "Рискованна."}, {"s": "Какой вид транспорта перевозит больше всего грузов (по объёму)?", "o": ["Автомобильный", "Морской транспорт", "Трубопроводный", "Воздушный"], "e": "Дёшев и рассчитан на большие объёмы."}, {"s": "Какой вид транспорта самый быстрый?", "o": ["Воздушный", "Железнодорожный", "Морской", "Автомобильный"], "e": "Из-за высокой стоимости перевозятся ценные грузы."}, {"s": "Что перевозит трубопроводный транспорт?", "o": ["Зерно", "Автомобили", "Нефть и газ", "Контейнеры"], "e": "Примером служит нефтепровод БТД."}, {"s": "Какая отрасль называется «лёгкой промышленностью»?", "o": ["Металлургия", "Нефтехимия", "Машиностроение", "Текстильная, швейная, кожевенная"], "e": "Производит потребительские товары."}, {"s": "Каковы основные отрасли сельского хозяйства?", "o": ["Промышленность", "Растениеводство и животноводство", "Только земледелие", "Торговля"], "e": "Дополняют друг друга."}, {"s": "Что является примером технических культур?", "o": ["Яблоко", "Пшеница", "Хлопок, табак", "Картофель"], "e": "Промышленное сырьё."}, {"s": "Что такое экспорт?", "o": ["Продажа товара за границу", "Налог", "Покупка товара", "Внутренняя торговля"], "e": "Противоположность импорта."}, {"s": "Что происходит при положительном торговом балансе?", "o": ["Экспорт превышает импорт", "Они равны", "Ноль", "Импорт превышает экспорт"], "e": "В страну поступает валюта."}, {"s": "Что такое глобализация?", "o": ["Изоляция", "Взаимная интеграция мировой экономики", "Миграция", "Налог"], "e": "Создаёт и возможности, и риски."}]}, "Dünya təsərrüfatı — 2-ci toplu": "Мировое хозяйство — Сборник 2"}