{"__q": {"t": "Лексика — Сборник 3", "q": [{"s": "Выберите синоним к слову «быстро»:", "o": ["медленно", "скоро", "громко", "тихо"], "e": "Наречие, близкое по значению."}, {"s": "Выберите антоним к слову «радость»:", "o": ["счастье", "смех", "веселье", "печаль"], "e": "Имеет противоположное значение."}, {"s": "Что означает фразеологизм «водить за нос»?", "o": ["хвалить", "учить", "обманывать", "помогать"], "e": "В значении «обмануть»."}, {"s": "Какое слово является заимствованным?", "o": ["вода", "дом", "менеджер", "хлеб"], "e": "Пришло из английского языка."}, {"s": "Какое слово устаревшее?", "o": ["школа", "компьютер", "ланиты", "телефон"], "e": "«Ланиты» — щёки."}, {"s": "Правильное употребление: «... пальто»", "o": ["одеть", "надеть", "положить", "обуть"], "e": "Одежду «надеть», человека «одеть»."}, {"s": "Тавтология — это...", "o": ["антонимия", "краткость", "синонимия", "неоправданное повторение однокоренных слов"], "e": "«Масло масляное»."}, {"s": "Что такое термин?", "o": ["слово, точно обозначающее научное понятие", "диалект", "разговорное слово", "жаргон"], "e": "Точно выражает научное понятие."}, {"s": "Выберите фразеологизм:", "o": ["белый снег", "читать книгу", "спустя рукава", "идти домой"], "e": "Это устойчивое словосочетание."}, {"s": "Что означает «спустя рукава»?", "o": ["очень старательно", "небрежно, плохо", "быстро", "аккуратно"], "e": "Работать небрежно."}]}, "Лексика — 3-ci toplu": "Лексика — Сборник 3"}