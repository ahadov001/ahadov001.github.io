{"__q": {"t": "Эволюция — Сборник 3", "q": [{"s": "В чём заключалась основная идея теории Ламарка?", "o": ["Мутация", "Изоляция", "Естественный отбор", "Наследование приобретённых признаков"], "e": "Впоследствии не подтвердилась."}, {"s": "Что такое микроэволюция?", "o": ["Возникновение новых классов", "Вымирание", "Изменения внутри популяции", "Крупные изменения"], "e": "Процессы, предшествующие видообразованию."}, {"s": "Что такое макроэволюция?", "o": ["Мутация", "Возникновение систематических групп выше вида", "Модификация", "Изменения популяций"], "e": "Требует длительного времени."}, {"s": "Что является элементарным материалом эволюции?", "o": ["Изоляция", "Мутации", "Модификация", "Естественный отбор"], "e": "Наследственная изменчивость поставляет материал."}, {"s": "Что говорит теория Опарина о возникновении жизни?", "o": ["Была всегда", "Пришла из космоса", "Постепенно возникла из неорганических веществ", "Была сотворена"], "e": "Стадия коацерватных капель."}, {"s": "Как питались первые живые организмы?", "o": ["Фотосинтез", "Автотрофно", "Хемосинтез", "Гетеротрофно"], "e": "Готовыми органическими веществами."}, {"s": "С чем связано появление кислорода в атмосфере?", "o": ["Метеориты", "Вулканы", "Океаны", "Начало фотосинтеза"], "e": "Сыграли роль сине-зелёные водоросли."}, {"s": "В какую эру жили динозавры?", "o": ["Архей", "Палеозой", "Мезозой", "Кайнозой"], "e": "Мезозойская эра называется «эрой пресмыкающихся»."}, {"s": "Кто ближайший современный родственник человека?", "o": ["Макака", "Шимпанзе", "Горилла", "Орангутан"], "e": "Генетическое сходство наибольшее."}, {"s": "Продолжается ли процесс эволюции?", "o": ["Только у растений", "Неизвестно", "Да, продолжается", "Нет, остановился"], "e": "Пример — устойчивость бактерий к антибиотикам."}]}, "Təkamül — 3-ci toplu": "Эволюция — Сборник 3"}