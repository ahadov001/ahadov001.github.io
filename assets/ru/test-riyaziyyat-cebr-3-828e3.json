{"__q": {"t": "Алгебраические выражения — Сборник 3", "q": [{"s": "Чему равно разложение (3a−2b)²?", "o": ["9a²−6ab+4b²", "9a²−12ab+4b²", "9a²+4b²", "3a²−12ab+2b²"], "e": "(3a)² − 2·3a·2b + (2b)²."}, {"s": "Разложите на множители выражение x²−5x+6.", "o": ["(x−1)(x−6)", "(x+2)(x+3)", "(x−2)(x−3)", "(x−5)(x+1)"], "e": "Числа с суммой −5 и произведением 6: −2 и −3."}, {"s": "Разложите на множители выражение a²+2ab+b²−c².", "o": ["Не раскладывается", "(a−b+c)(a−b−c)", "(a+b)²−c", "(a+b+c)(a+b−c)"], "e": "(a+b)²−c² — разность квадратов."}, {"s": "Разложите на множители выражение x⁴−1.", "o": ["(x²+1)²", "(x²−1)(x²+1)", "(x−1)(x+1)(x²+1)", "(x−1)⁴"], "e": "Раскладывается в два этапа."}, {"s": "Чему равно (x+y)²−(x−y)²?", "o": ["2xy", "4xy", "2x²", "0"], "e": "Разность квадратов: (2x)(2y) = 4xy."}, {"s": "Сократите алгебраическую дробь: (x²−4)/(x+2).", "o": ["x+2", "x²−2", "x−2", "1"], "e": "Числитель раскладывается как (x−2)(x+2)."}, {"s": "Чему равно a/b + c/b?", "o": ["a+c", "(a+c)/b", "(a+c)/2b", "ac/b"], "e": "Знаменатели одинаковы."}, {"s": "Чему равно 1/x + 1/y?", "o": ["(x+y)/xy", "1/(xy)", "2/(x+y)", "(x−y)/xy"], "e": "Общий знаменатель — xy."}, {"s": "Чему равно (a+b)/(a+b) (a+b≠0)?", "o": ["a", "0", "1", "b"], "e": "Отношение выражения к самому себе равно 1."}, {"s": "Чему равно x²y³ · x³y?", "o": ["x⁶y⁴", "x⁵y⁴", "x⁵y³", "x⁶y³"], "e": "Показатели степеней с одинаковыми основаниями складываются."}]}, "Cəbri ifadələr — 3-ci toplu": "Алгебраические выражения — Сборник 3"}